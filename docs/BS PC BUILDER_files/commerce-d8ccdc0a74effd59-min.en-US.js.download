    }{.end}{#
  }{.or}{#
    }{@assert|apply:assert-prop: :level=error: :message=requires a positive integer, but received a non-integer value:}{#
  }{.end}{#
}{.end}{#

## assert-boolean: assert that a prop is a boolean
