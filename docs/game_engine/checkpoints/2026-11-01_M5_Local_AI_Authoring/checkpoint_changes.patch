+from native_studio.game_engine.content_view import ContentView
+from native_studio.theme import STYLESHEET
+root=Path('C:/AI-BS');proof=json.loads((root/'engine/out/ai-live-proof-d466b16d-66e1-4c70-b29c-9a3af6c4a5a9/live-ai-verification.json').read_text())
+app=QApplication.instance() or QApplication([]);QFontDatabase.addApplicationFont('C:/Windows/Fonts/segoeui.ttf');app.setFont(QFont('Segoe UI',10));app.setStyleSheet(STYLESHEET)
+view=ContentView(root/'engine/out/windows-msvc/Debug/aibs_content_host.exe');view.resize(1720,1280)
+def spin(predicate):
+    end=time.monotonic()+20
+    while not predicate():
+        if time.monotonic()>end:raise RuntimeError('Actual creator capture timed out')
+        app.processEvents();time.sleep(.005)
+try:
+    view.show();view.open_project(Path(proof['work_directory'])/'project');spin(lambda:view.loaded and not view.busy and not view.client.pending_count)
+    view.select_entity(proof['before']['door_uuid']);view.refresh_ai_models();spin(lambda:not view.ai_client.busy)
+    index=next(i for i in range(view.ai_model_combo.count()) if getattr(view.ai_model_combo.itemData(i),'name',None)==proof['model'])
+    view.ai_model_combo.setCurrentIndex(index);view.ai_prompt.setPlainText(proof['instruction'])
+    for _ in range(10):
+        view.repaint();view.outliner.viewport().repaint();view.projects.viewport().repaint();app.processEvents();time.sleep(.02)
+    assert view.description.fingerprint==proof['after']['fingerprint']
+    print('Visible actual outliner rows:',view.outliner.topLevelItemCount())
+    assert view.grab().save(str(root/'engine/out/ai-authoring-current.png'))
+    print('Saved actual generated edit reopened; dark prompt contrast capture saved. No inference requested.')
+finally:
+    view.cancel_ai_generation()
+    if view.client.state!='closed':view.close_project(discard=True)
