+"""Seal cumulative selected source and actual release evidence with bounded RAM."""
+from datetime import datetime, timezone
+from pathlib import Path
+import difflib
+import hashlib
+import json
+import re
+import shutil
+import subprocess
+import zipfile
+
+root=Path('C:/AI-BS')
+dest=root/'docs/game_engine/checkpoints/2026-11-01_M5_Native95_Creator_Deployment'
+work=root/'backups/native_game95_20261101_creator'
+archive=root/'backups/checkpoint_20261101_native95_creator/AI_BS_Native95_Creator_Source.zip'
+assert not archive.exists(), 'Existing source seal protected'
+archive.parent.mkdir(parents=True,exist_ok=True)
+def sha(path):
+    with path.open('rb') as stream:return hashlib.file_digest(stream,'sha256').hexdigest()
+def git(*args):return subprocess.check_output(['git',*args],cwd=root)
+proof=json.loads((root/'engine/out/native_creator_release_verification.json').read_text(encoding='utf-8'))
+independent=json.loads((root/'engine/out/native95-independent-acceptance.json').read_text(encoding='utf-8'))
+assert proof['status']=='passed' and independent['status']=='passed'
+(dest/'git_status.txt').write_bytes(git('status','--porcelain=v1','--untracked-files=all'))
+(dest/'tracked_changes.patch').write_bytes(git('diff','--binary','--','engine','native_studio/game_engine',
+    'native_studio/game_build_monitor.py','native_studio/game_build_view.py','native_studio/app.py',
+    'native_studio/game_release_smoke.py','scripts/build_native_game_release.py',
+    'scripts/verify_native_creator_release.py','scripts/tests/test_native_creator_verification.py'))
+prior_path=root/'backups/checkpoint_20261101_native95_restart/AI_BS_Native95_Restart_Source.zip'
+with zipfile.ZipFile(prior_path) as prior:
+    old=json.loads(prior.read('source_manifest.json'));old_entries={e['path']:e for e in old['files']}
+    paths=set(old_entries)
+    paths.update(['engine/CREATOR_QUICKSTART.md','engine/out/native_creator_release_verification.json',
+        'engine/out/native95-independent-acceptance.json','engine/out/run_native95_acceptance.py',
+        'engine/out/publish_native95_creator.py','engine/out/checkpoint_native95_creator.py',
+        'docs/agent_sync/manifest_m5_native95_restart_20261101.json'])
+    paths.update(p.relative_to(root).as_posix() for p in (root/'engine/out').glob('native95-*') if p.is_file())
+    paths.update(p.relative_to(root).as_posix() for p in work.iterdir() if p.is_file())
+    for directory in list(work.glob('frozen_*-work-*'))+[work/'shortcut_before']:
+        paths.update(p.relative_to(root).as_posix() for p in directory.rglob('*') if p.is_file())
+    # Preserve exact verifier failure and fix evidence while excluding its synthetic dependency fixture copies.
+    for pattern in ('*native*creator*.log','*native*creator*.json'):
+        paths.update(p.relative_to(root).as_posix() for p in (root/'engine/out').glob(pattern) if p.is_file())
+    paths.update(p.relative_to(root).as_posix() for p in dest.iterdir() if p.is_file())
+    entries=[];changes=[];patch=[]
+    marker=re.compile(r'-----BEGIN (?:RSA |EC |OPENSSH )?PRIVATE KEY-----|\bghp_[A-Za-z0-9]{30,}|\bsk-(?:proj-)?[A-Za-z0-9_-]{25,}|\bAIzaSy[A-Za-z0-9_-]{25,}')
+    text_suffixes={'.py','.cpp','.hpp','.md','.json','.js','.txt','.ps1','.spec','.log','.patch'}
+    with zipfile.ZipFile(archive,'x',zipfile.ZIP_DEFLATED,compresslevel=6) as output:
+        for name in sorted(paths):
+            path=root/name;before=path.stat();digest=sha(path);previous=old_entries.get(name)
+            changed=previous is None or previous['sha256']!=digest
+            if changed:changes.append({'path':name,'before_sha256':previous['sha256'] if previous else None,'after_sha256':digest})
+            if changed and path.suffix in text_suffixes:
+                data=path.read_bytes()
+                try:text=data.decode('utf-16' if data[:2] in (b'\xff\xfe',b'\xfe\xff') else 'utf-8-sig')
+                except UnicodeDecodeError:text=None
+                if text is not None:
+                    assert not marker.search(text), 'Credential marker in '+name
+                    if path.suffix not in {'.log','.patch'}:
+                        previous_text=prior.read(name).decode('utf-8-sig') if previous else ''
+                        patch.extend(difflib.unified_diff(previous_text.splitlines(True),text.splitlines(True),fromfile='prior/'+name,tofile='current/'+name))
+            output.write(path,name)
+            after=path.stat()
+            assert (before.st_size,before.st_mtime_ns)==(after.st_size,after.st_mtime_ns), name
+            entries.append({'path':name,'bytes':before.st_size,'sha256':digest})
