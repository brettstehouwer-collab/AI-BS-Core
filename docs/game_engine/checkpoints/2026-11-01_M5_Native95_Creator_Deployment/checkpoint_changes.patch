+"""Run explicit frozen acceptance without launching normal Studio services."""
+from datetime import datetime, timezone
+from pathlib import Path
+import json
+import os
+import subprocess
+import sys
+import time
+
+root = Path('C:/AI-BS')
+work = root / 'backups/native_game95_20261101_creator'
+exe = root / 'native_studio/releases/v5.329.95/AI_BS_Studio/AI_BS_Studio.exe'
+mode = sys.argv[1]
+assert mode in ('monitor', 'monitor_deployed', 'fixture', 'fixture_windows', 'live')
+report = work / ('frozen_' + mode + '.json')
+assert not report.exists(), 'Existing evidence protected'
+arguments = [str(exe), '--game-build-smoke' if mode.startswith('monitor') else '--creator-release-smoke', str(report)]
+if mode == 'live':
+    arguments += ['--creator-smoke-provider', 'ollama', '--creator-smoke-model', 'qwen2.5-coder:latest',
+                  '--creator-smoke-url', 'http://127.0.0.1:11434']
+environment = os.environ.copy()
+for name in ('PYTHONPATH', 'PYTHONHOME', 'QT_PLUGIN_PATH', 'QT_QPA_PLATFORM_PLUGIN_PATH'):
+    environment.pop(name, None)
+environment['QT_QPA_PLATFORM'] = 'windows' if mode in ('fixture_windows', 'monitor_deployed') else 'offscreen'
+for name in ('AI_BS_NATIVE_MANAGE_DAEMONS', 'AI_BS_NATIVE_EXIT_PROCESS_CLEANUP', 'AI_BS_NATIVE_BACKGROUND_UPDATES'):
+    environment[name] = 'false'
+started = time.monotonic()
+with (work / ('frozen_' + mode + '.stdout.log')).open('wb') as stdout, (work / ('frozen_' + mode + '.stderr.log')).open('wb') as stderr:
+    completed = subprocess.run(arguments, cwd=exe.parent, env=environment, stdout=stdout, stderr=stderr,
+                               timeout=300, creationflags=subprocess.CREATE_NO_WINDOW)
+data = json.loads(report.read_text(encoding='utf-8')) if report.is_file() else {}
+receipt = {'utc': datetime.now(timezone.utc).isoformat(), 'mode': mode, 'executable': str(exe),
+           'exit_code': completed.returncode, 'elapsed_seconds': round(time.monotonic() - started, 3),
+           'report': str(report), 'status': data.get('status', 'missing'),
+           'frozen': data.get('frozen'), 'actual_model_inference': data.get('actual_model_inference'),
+           'application_services_started': data.get('application_services_started'),
+           'all_owned_processes_joined': data.get('all_owned_processes_joined'), 'error': data.get('error')}
+(work / ('frozen_' + mode + '_process.json')).write_text(json.dumps(receipt, indent=2) + '\n', encoding='utf-8')
+print(json.dumps(receipt, indent=2))
+assert completed.returncode == 0 and data.get('status') == 'passed' and data.get('frozen') is True, receipt
+assert data.get('application_services_started') is False
+if not mode.startswith('monitor'):
+    assert data.get('all_owned_processes_joined') is True
+    assert data.get('actual_model_inference') is (mode == 'live')
