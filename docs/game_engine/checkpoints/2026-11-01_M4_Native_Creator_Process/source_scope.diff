+    def test_invalid_utf8_uuid_and_huge_lengths(self):
+        raw = bytearray(encode_edit(self.request()))
+        for offset, value in ((0, b'\x02\0'), (2, b'\xff\xff\xff\xff'), (6, b'\xff'),
+                              (6, b'\0')):
