+    return (struct.pack('<HH',1,status)+text(message)+text(UUID)+text('p')+text('b')+text(UUID)+
+            struct.pack('<Q',9)+text('')+struct.pack('<Q',1)+text('')+text('')+struct.pack('<BQ',compatible,0)+
