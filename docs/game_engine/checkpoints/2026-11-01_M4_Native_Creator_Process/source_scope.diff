--- pause/engine/include/aibs/creator_host.hpp
+++ current/engine/include/aibs/creator_host.hpp
@@ -0,0 +1,116 @@
+#pragma once
+#include <aibs/persistence.hpp>
+#include <functional>
+#include <memory>
+
+namespace aibs {
+struct CreatorScope {
+ std::string project, branch, world_id;
+ bool operator==(const CreatorScope&) const = default;
+};
+struct CreatorHostLimits {
+ std::size_t maximum_live_entities = 10000;
+ std::size_t maximum_fields_per_entity = 64;
+ std::size_t maximum_string_bytes = 4096;
+ std::size_t maximum_edits = 256;
+ std::size_t maximum_request_bytes = 1024 * 1024;
+ std::size_t maximum_session_bytes = 64 * 1024 * 1024;
+ std::size_t maximum_prepared = 8;
+ std::size_t maximum_prepared_bytes = 64 * 1024 * 1024;
+ std::size_t maximum_history_receipts = 1024;
+};
+// References retain a private immutable session; publication never mutates it.
+// Logical storage budgets do not bound RSS, temporary Core copies, or snapshots
+// and Play contexts retained by a client after the host releases them.
+class CreatorSnapshot {
+ std::shared_ptr<const CreatorSession> owner_;
+ friend class CreatorHost;
+ explicit CreatorSnapshot(std::shared_ptr<const CreatorSession> owner, std::size_t reserved_checkpoint_bytes);
+public:
+ const CreatorScope scope;
+ const std::uint64_t revision;
+ const World& world;
+ const std::vector<MemoryEvent>& history;
+ const std::map<std::string, FieldSchema>& schemas;
+ const std::string& checkpoint_id;
+ const std::size_t undo_depth, redo_depth, receipt_count, charged_bytes;
+ CreatorSnapshot(const CreatorSnapshot&) = delete;
+ CreatorSnapshot& operator=(const CreatorSnapshot&) = delete;
+};
+struct CreatorDependencyPreview {
+ bool valid = true;
+ bool render_rebuild = false, collision_rebuild = false;
+ bool navigation_validated = false;
+ std::vector<std::string> changed_uuids, dependency_keys, notes;
+ CheckpointAssessment save{false, 0, "Not assessed"};
+ bool operator==(const CreatorDependencyPreview&) const = default;
+};
+using CreatorAssessor = std::function<CreatorDependencyPreview(const CreatorSnapshot&, const CreatorSnapshot&, const Transaction&)>;
+namespace detail { struct CreatorEpoch; }
+class CreatorPreparedChange {
+ friend class CreatorHost;
+ std::shared_ptr<const detail::CreatorEpoch> owner_;
+ std::uint64_t generation_;
+ Transaction request_;
+ std::shared_ptr<const CreatorSnapshot> before_, after_;
+ CreatorDependencyPreview dependencies_;
+ CreatorAssessor assessor_;
+ CreatorPreparedChange(std::shared_ptr<const detail::CreatorEpoch>, std::uint64_t,
+  Transaction, std::shared_ptr<const CreatorSnapshot>, std::shared_ptr<const CreatorSnapshot>,
+  CreatorDependencyPreview, CreatorAssessor);
+public:
+ std::shared_ptr<const CreatorSnapshot> snapshot() const noexcept { return after_; }
+ const CreatorDependencyPreview& dependencies() const noexcept { return dependencies_; }
+ CreatorPreparedChange(const CreatorPreparedChange&) = delete;
+ CreatorPreparedChange& operator=(const CreatorPreparedChange&) = delete;
+};
+using CreatorPreparedPtr = std::shared_ptr<const CreatorPreparedChange>;
+enum class CreatorHostStatus { prepared, applied, duplicate, undone, redone, saved, playing, stopped, rejected };
+struct CreatorHostResult {
+ CreatorHostStatus status;
+ std::string message;
+ std::uint64_t revision;
+ CreatorPreparedPtr change{};
+};
+enum class CreatorHistoryDirection { undo, redo };
+struct CreatorHistoryRequest {
+ std::string id, host_epoch;
+ CreatorScope scope;
+ std::uint64_t expected_revision;
+ CreatorHistoryDirection direction;
+ bool operator==(const CreatorHistoryRequest&) const = default;
+};
+struct CreatorPlaySession {
+ const std::string epoch;
+ const CreatorScope scope;
+ const std::uint64_t authored_revision;
+ World world;
+};
+// Single-threaded owner; UI/SDK/proposals share these exact admission rules.
+// Dependency callbacks are bounded observations; reentrant mutations reject.
+// Chapter topology and navigation require a game-specific assessor, not guesses.
+class CreatorHost {
+ struct State;
+ std::unique_ptr<State> state_;
+ static std::shared_ptr<const CreatorSnapshot> describe(std::shared_ptr<const CreatorSession>, std::size_t reserved_checkpoint_bytes = 0);
+ CreatorDependencyPreview assess(const std::shared_ptr<const CreatorSnapshot>&,
+  const std::shared_ptr<const CreatorSnapshot>&, const Transaction&, const CreatorAssessor&) const;
+public:
+ explicit CreatorHost(CreatorSession&&, CreatorHostLimits = {});
+ ~CreatorHost();
+ CreatorHost(const CreatorHost&) = delete;
+ CreatorHost& operator=(const CreatorHost&) = delete;
+ static CreatorHost open(const std::filesystem::path&, SchemaRegistry, std::string project,
+  std::string branch, CreatorHostLimits = {});
+ std::shared_ptr<const CreatorSnapshot> snapshot() const noexcept;
+ const std::string& epoch_id() const noexcept;
+ CreatorHostResult preview(const CreatorScope&, const Transaction&, CreatorAssessor = {});
+ CreatorHostResult apply(CreatorPreparedPtr);
+ CreatorHostResult apply(const CreatorScope&, const Transaction&, CreatorAssessor = {});
+ CreatorHostResult travel(const CreatorHistoryRequest&);
+ CreatorHostResult save(const std::filesystem::path&);
+ CreatorHostResult start_play(const CreatorScope&, std::uint64_t expected_revision);
+ CreatorHostResult stop_play(const std::string& play_epoch);
+ std::shared_ptr<CreatorPlaySession> play() const noexcept;
+};
+}
--- pause/engine/include/aibs/creator_payload.hpp
+++ current/engine/include/aibs/creator_payload.hpp
@@ -0,0 +1,109 @@
+#pragma once
+#include <aibs/creator_host.hpp>
+#include <aibs/creator_wire.hpp>
+#include <bit>
+#include <cmath>
+#include <string_view>
+
+namespace aibs::creator_payload {
+inline constexpr std::size_t maximum_bytes=1024*1024;
+struct EditRequest { CreatorScope scope; std::string host_epoch; Transaction transaction; };
+class PayloadError : public std::runtime_error { public: using std::runtime_error::runtime_error; };
+namespace detail {
+inline void ensure(bool value,const char* reason) { if(!value) throw PayloadError(reason); }
+inline bool utf8(std::string_view text) noexcept {
+ std::size_t i=0;
+ while(i<text.size()) {
+  const auto first=static_cast<unsigned char>(text[i++]);
+  if(first==0) return false;
+  if(first<0x80) continue;
+  unsigned count=0; std::uint32_t code=0, minimum=0;
+  if(first>=0xc2&&first<=0xdf) {count=1;code=first&0x1f;minimum=0x80;}
+  else if(first>=0xe0&&first<=0xef) {count=2;code=first&0xf;minimum=0x800;}
+  else if(first>=0xf0&&first<=0xf4) {count=3;code=first&7;minimum=0x10000;}
+  else return false;
+  if(count>text.size()-i) return false;
+  for(unsigned j=0;j<count;++j) {
+   const auto next=static_cast<unsigned char>(text[i++]);
+   if(next<0x80||next>0xbf) return false;
+   code=(code<<6)|(next&0x3f);
+  }
+  if(code<minimum||code>0x10ffff||(code>=0xd800&&code<=0xdfff)) return false;
+ }
+ return true;
+}
+inline void uuid(const std::string& value,bool optional=false) {ensure((optional&&value.empty())||is_uuid(value),"Invalid canonical UUID");}
+struct Writer {
+ std::vector<unsigned char> data;
+ void number(std::uint64_t value,unsigned width) {
+  ensure(width<=maximum_bytes-data.size(),"Payload size limit");
+  creator_wire::detail::append(data,value,width);
+ }
+ void text(const std::string& value,bool required=false) {
+  ensure(value.size()<=4096&&utf8(value)&&(!required||!value.empty()),"Invalid bounded UTF-8 text");
+  number(value.size(),4);ensure(value.size()<=maximum_bytes-data.size(),"Payload size limit");
+  data.insert(data.end(),value.begin(),value.end());
+ }
+ void real(double value) {ensure(std::isfinite(value),"Non-finite number");number(std::bit_cast<std::uint64_t>(value),8);}
+};
+struct Reader {
+ std::span<const unsigned char> data;std::size_t offset=0;
+ std::uint64_t number(unsigned width) {
+  ensure(width<=data.size()-offset,"Truncated payload");
+  const auto value=creator_wire::detail::number(data,offset,width);offset+=width;return value;
+ }
+ std::string text(bool required=false) {
+  const auto size=number(4);ensure(size<=4096&&size<=data.size()-offset,"Invalid text length");
+  const auto view=std::string_view(reinterpret_cast<const char*>(data.data()+offset),static_cast<std::size_t>(size));
+  ensure(utf8(view)&&(!required||!view.empty()),"Invalid bounded UTF-8 text");offset+=static_cast<std::size_t>(size);return std::string(view);
+ }
+ double real() {const auto value=std::bit_cast<double>(number(8));ensure(std::isfinite(value),"Non-finite number");return value;}
+};
+}
+inline std::vector<unsigned char> encode_edit(const EditRequest& request) {
+ detail::Writer w;w.number(1,2);
+ detail::uuid(request.scope.world_id);detail::uuid(request.host_epoch);
+ w.text(request.scope.project,true);w.text(request.scope.branch,true);w.text(request.scope.world_id,true);w.text(request.host_epoch,true);
+ const auto& t=request.transaction;w.text(t.id,true);w.number(t.expected_revision,8);w.text(t.description);
+ detail::ensure(!t.edits.empty()&&t.edits.size()<=256,"Edit count limit");w.number(t.edits.size(),4);
+ for(const auto& edit:t.edits) {
+  w.number(edit.index(),1);
+  if(const auto* c=std::get_if<Create>(&edit)) {
+   const auto& e=c->entity;w.text(e.id,true);w.text(e.name);detail::uuid(e.persistent_id,true);w.text(e.persistent_id);
+   detail::ensure(e.fields.size()<=64,"Field count limit");w.number(e.fields.size(),4);
+   for(const auto& [field,value]:e.fields) {w.text(field,true);w.real(value);}
+  } else if(const auto* e=std::get_if<Erase>(&edit)) {w.text(e->entity,true);detail::uuid(e->persistent_id,true);w.text(e->persistent_id);}
+  else {
+   const auto& s=std::get<SetField>(edit);w.text(s.entity,true);w.text(s.field,true);w.real(s.value);
+   detail::uuid(s.persistent_id,true);w.text(s.persistent_id);
+  }
+ }
+ return w.data;
+}
+inline EditRequest decode_edit(std::span<const unsigned char> bytes) {
+ detail::ensure(bytes.size()<=maximum_bytes,"Payload size limit");detail::Reader r{bytes};
+ detail::ensure(r.number(2)==1,"Unsupported payload version");EditRequest request;
+ request.scope.project=r.text(true);request.scope.branch=r.text(true);request.scope.world_id=r.text(true);request.host_epoch=r.text(true);
+ detail::uuid(request.scope.world_id);detail::uuid(request.host_epoch);
+ auto& t=request.transaction;t.id=r.text(true);t.expected_revision=r.number(8);t.description=r.text();
+ const auto count=r.number(4);detail::ensure(count>0&&count<=256,"Edit count limit");
+ for(std::uint64_t i=0;i<count;++i) {
+  const auto tag=r.number(1);detail::ensure(tag<=2,"Unknown edit tag");auto alias=r.text(true);
+  if(tag==0) {
+   Entity entity;entity.id=std::move(alias);entity.name=r.text();entity.persistent_id=r.text();detail::uuid(entity.persistent_id,true);
+   const auto fields=r.number(4);detail::ensure(fields<=64,"Field count limit");
+   for(std::uint64_t j=0;j<fields;++j) {
+    auto key=r.text(true);const auto value=r.real();
+    detail::ensure(entity.fields.emplace(std::move(key),value).second,"Duplicate field key");
+   }
+   t.edits.push_back(Create{std::move(entity)});
+  } else if(tag==1) {
+   auto uuid=r.text();detail::uuid(uuid,true);t.edits.push_back(Erase{std::move(alias),std::move(uuid)});
+  } else {
+   auto field=r.text(true);const auto value=r.real();auto uuid=r.text();detail::uuid(uuid,true);
+   t.edits.push_back(SetField{std::move(alias),std::move(field),value,std::move(uuid)});
+  }
+ }
+ detail::ensure(r.offset==bytes.size(),"Trailing payload bytes");return request;
+}
+}
--- pause/engine/include/aibs/creator_wire.hpp
+++ current/engine/include/aibs/creator_wire.hpp
@@ -0,0 +1,106 @@
+#pragma once
+#include <algorithm>
+#include <array>
+#include <cstdint>
+#include <limits>
+#include <span>
+#include <stdexcept>
+#include <vector>
+
+namespace aibs::creator_wire {
+inline constexpr std::size_t maximum_payload = 4 * 1024 * 1024;
+inline constexpr std::size_t maximum_chunk = 65536;
+inline constexpr std::size_t maximum_burst = 8;
+inline constexpr std::uint64_t unscoped_revision = (std::numeric_limits<std::uint64_t>::max)();
+enum class Opcode : std::uint16_t {
+ hello=1, open=0x10, describe=0x11, snapshot_page=0x12,
+ preview=0x20, apply_prepared=0x21, apply_transaction=0x22, release_prepared=0x23,
+ history=0x30, save=0x40, start_play=0x50, stop_play=0x51, shutdown=0xff
+};
+struct Frame {
+ Opcode opcode;
+ std::uint64_t request_id;
+ std::array<unsigned char,16> epoch;
+ std::uint64_t revision;
+ std::vector<unsigned char> payload;
+ bool response = false;
+ bool operator==(const Frame&) const = default;
+};
+class WireError : public std::runtime_error { public: using std::runtime_error::runtime_error; };
+namespace detail {
+inline void ensure(bool condition, const char* message) { if (!condition) throw WireError(message); }
+inline bool known(std::uint64_t op) noexcept {
+ switch(op) {
+ case 1: case 0x10: case 0x11: case 0x12: case 0x20: case 0x21: case 0x22: case 0x23:
+ case 0x30: case 0x40: case 0x50: case 0x51: case 0xff: return true;
+ default: return false;
+ }
+}
+inline std::uint64_t number(std::span<const unsigned char> bytes, std::size_t offset, unsigned width) {
+ std::uint64_t value=0;
+ for (unsigned i=0;i<width;++i) value |= static_cast<std::uint64_t>(bytes[offset+i]) << (8*i);
+ return value;
+}
+inline void append(std::vector<unsigned char>& bytes, std::uint64_t value, unsigned width) {
+ for(unsigned i=0;i<width;++i) bytes.push_back(static_cast<unsigned char>(value >> (8*i)));
+}
+}
+inline std::vector<unsigned char> encode(const Frame& frame) {
+ detail::ensure(detail::known(static_cast<std::uint16_t>(frame.opcode)), "Unknown creator opcode");
+ detail::ensure(frame.request_id && frame.payload.size()<=maximum_payload, "Invalid creator request or payload size");
+ std::vector<unsigned char> bytes; bytes.reserve(48+frame.payload.size());
+ for(const auto c : {'A','I','B','C'}) bytes.push_back(static_cast<unsigned char>(c));
+ detail::append(bytes,1,2); detail::append(bytes,48,2);
+ detail::append(bytes,static_cast<std::uint16_t>(frame.opcode),2); detail::append(bytes,frame.response?1:0,2);
+ detail::append(bytes,frame.payload.size(),4); detail::append(bytes,frame.request_id,8);
+ bytes.insert(bytes.end(),frame.epoch.begin(),frame.epoch.end()); detail::append(bytes,frame.revision,8);
+ bytes.insert(bytes.end(),frame.payload.begin(),frame.payload.end()); return bytes;
+}
+// Framing only; payload schemas, epoch negotiation and owner dispatch are later
