+        request = self.request()
+        for scope in (Scope('p', 'b', 'bad', UUID), Scope('p', 'b', UUID.upper(), UUID)):
+            with self.assertRaises(PayloadError):
+                encode_edit(EditRequest(scope, request.transaction))
+
