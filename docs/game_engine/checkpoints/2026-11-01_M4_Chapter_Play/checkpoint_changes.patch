+"""Capture the real source chapter widget against a real native owner."""
+import os
+os.environ['QT_QPA_PLATFORM']='offscreen'
+from pathlib import Path
+import tempfile,time
+from PyQt6.QtGui import QFont,QFontDatabase
+from PyQt6.QtWidgets import QApplication
+from native_studio.game_engine.content_view import ContentView
+from native_studio.theme import STYLESHEET
+root=Path('C:/AI-BS');app=QApplication.instance() or QApplication([])
+QFontDatabase.addApplicationFont('C:/Windows/Fonts/segoeui.ttf');app.setFont(QFont('Segoe UI',10));app.setStyleSheet(STYLESHEET)
+def wait(predicate):
+    deadline=time.monotonic()+20
+    while not predicate():
+        if time.monotonic()>deadline:raise RuntimeError('Actual chapter widget timed out')
+        app.processEvents();time.sleep(.005)
+with tempfile.TemporaryDirectory(prefix='aibs-chapter-play-capture-') as directory:
+    view=ContentView(root/'engine/out/windows-msvc/Debug/aibs_content_host.exe');view.resize(1720,1120);view.show()
+    try:
+        view.new_project(Path(directory),'First Boot creator study');wait(lambda:view.loaded and not view.busy and not view.client.pending_count)
+        door=next(row for row in view.rows if row.type_id=='firstboot.Door' and dict(row.fields)['role']=='main')
+        view.select_entity(door.uuid);view.field_editors['x'].setText('-32.5');view.preview_selected()
+        wait(lambda:view.apply_button.isEnabled())
+        app.processEvents();target=root/'engine/out/chapter-creator-play-real.png'
+        assert view.grab().save(str(target))
+        print(str(target))
+    finally:
+        view.close_project(discard=True);wait(lambda:view.client.state=='closed' and view.play.state=='closed' and view.viewport.state=='closed');view.close();app.processEvents()
