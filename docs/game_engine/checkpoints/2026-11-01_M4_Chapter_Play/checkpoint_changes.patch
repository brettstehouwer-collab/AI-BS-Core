+for directory,pattern in [('engine/apps','*.cpp'),('engine/tests','*.cpp'),('engine/tests','*.py'),('native_studio/game_engine','*.py')]:
+    paths.update(p.relative_to(root).as_posix() for p in (root/directory).glob(pattern))
+paths.update(['engine/include/aibs/chapter_viewport.hpp','engine/cmake/NativeCapabilities.json.in',
+    'engine/CHAPTER_PLAY.md','docs/game_engine/m4_acceptance_audit.md',
