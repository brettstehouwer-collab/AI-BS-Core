+    paths.update(p.relative_to(root).as_posix() for p in (root/'engine/out').glob(pattern))
+for pattern in ('chapter-export*','chapter-viewport-gpu*','viewport-updates-*','chapter-play-installed*','chapter-viewport-installed*','chapter-stop-installed*','chapter-legacy-final.*','durable-legacy-final.*'):
+    for directory in (root/'engine/out').glob(pattern):
+        if directory.is_dir():paths.update(p.relative_to(root).as_posix() for p in directory.rglob('*') if p.is_file())
+for report in (root/'engine/out').glob('content-*-verification-*.json'):
+    value=json.loads(report.read_text(encoding='utf-8-sig'))
+    work=Path(value.get('work_directory','')).resolve()
+    if value.get('status')=='passed' and work.is_relative_to((root/'engine/out').resolve()):
+        paths.update(p.relative_to(root).as_posix() for p in work.rglob('*') if p.is_file())
+paths.update(p.relative_to(root).as_posix() for p in dest.iterdir() if p.is_file())
+content={name:(root/name).read_bytes() for name in sorted(paths)}
+marker=re.compile(r'-----BEGIN (?:RSA |EC |OPENSSH )?PRIVATE KEY-----|\bghp_[A-Za-z0-9]{30,}|\bsk-(?:proj-)?[A-Za-z0-9_-]{25,}|\bAIzaSy[A-Za-z0-9_-]{25,}')
+syntax=0;changed=[];patch=[]
+for name,data in content.items():
+    before=old.get(name)
+    if before!=data:changed.append({'path':name,'before_sha256':hashlib.sha256(before).hexdigest() if before is not None else None,'after_sha256':hashlib.sha256(data).hexdigest()})
+    if Path(name).suffix not in ('.py','.cpp','.hpp','.md','.json','.txt','.ps1','.in','.log','.patch'):continue
+    try:text=data.decode('utf-16' if data[:2] in (b'\xff\xfe',b'\xfe\xff') else 'utf-8-sig')
