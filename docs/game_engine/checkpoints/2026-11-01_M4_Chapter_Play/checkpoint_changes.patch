@@ -0,0 +1,24 @@
+from pathlib import Path
+from datetime import datetime,timezone
+import hashlib,json,subprocess
+root=Path('C:/AI-BS');results=[]
+for config in ('Debug','Release'):
+    prefix='engine/install/'+config.lower()
+    consumer='engine/out/sdk-consumer-'+config.lower()
+    commands=[('install',['cmake','--install','engine/out/windows-msvc','--config',config,'--prefix',prefix]),
+        ('sdk-build',['cmake','--build',consumer,'--config',config]),
+        ('sdk',['ctest','--test-dir',consumer,'-C',config,'--output-on-failure'])]
+    for label,args in commands:
+        run=subprocess.run(args,cwd=root,stdout=subprocess.PIPE,stderr=subprocess.STDOUT)
+        path='engine/out/chapter-play-'+label+'.'+config+'.log';(root/path).write_bytes(run.stdout)
+        results.append({'configuration':config,'step':label,'command':args,'exit_code':run.returncode,'log':path})
+        if run.returncode:
+            print(run.stdout.decode(errors='replace')[-3000:]);raise SystemExit(run.returncode)
+    for exe in ('aibs_content_host.exe','aibs_creator_viewport.exe','aibs_motherboard.exe'):
+        source=root/'engine/out/windows-msvc'/config/exe;installed=root/prefix/'bin'/exe
+        digest=hashlib.sha256(installed.read_bytes()).hexdigest()
+        assert digest==hashlib.sha256(source.read_bytes()).hexdigest()
+        results.append({'configuration':config,'installed_executable':str(installed),'sha256':digest,'source_match':True})
+proof={'schema_version':1,'status':'passed','completed_at':datetime.now(timezone.utc).isoformat(),'results':results}
+(root/'engine/out/chapter-play-install-verification.json').write_text(json.dumps(proof,indent=2)+'\n',encoding='utf-8')
+print('Debug/Release SDK installed; external chapter projection consumers1/1 each; all3 installed executable hashes match each source configuration.')
