+"""Exercise final installed binaries in isolated native proof directories."""
+from pathlib import Path
+from datetime import datetime,timezone
+import json,subprocess
+root=Path('C:/AI-BS');results=[]
+for config in ('Debug','Release'):
+    binaries=root/'engine/install'/config.lower()/'bin'
+    fixture=root/'engine/out/windows-msvc'/config/'aibs_content_play_fixture.exe'
+    jobs=[('play','verify_content_play.py',[binaries/'aibs_motherboard.exe',fixture,root/('engine/out/chapter-play-installed.'+config)]),
+          ('stop','verify_content_stop.py',[binaries/'aibs_motherboard.exe',fixture,root/('engine/out/chapter-stop-installed.'+config)]),
+          ('viewport','verify_chapter_viewport.py',[binaries/'aibs_content_host.exe',root/('engine/out/chapter-viewport-installed.'+config),binaries/'aibs_creator_viewport.exe']),
+          ('updates','verify_viewport_updates.py',[binaries/'aibs_content_host.exe',binaries/'aibs_creator_viewport.exe',root/('engine/out/viewport-updates-installed.'+config)])]
+    for label,script,args in jobs:
+        command=['python',str(root/'engine/tests'/script),*[str(arg) for arg in args]]
+        run=subprocess.run(command,cwd=root,stdout=subprocess.PIPE,stderr=subprocess.STDOUT)
+        log=root/('engine/out/chapter-play-installed-'+label+'.'+config+'.log');log.write_bytes(run.stdout)
+        if run.returncode:
+            print(run.stdout.decode(errors='replace')[-4000:]);raise SystemExit(run.returncode)
+        result=json.loads(run.stdout.decode('utf-8-sig'))
+        if result['status']!='passed':raise RuntimeError('Installed proof did not pass')
+        results.append({'configuration':config,'step':label,'command':command,'exit_code':run.returncode,
+            'log':log.relative_to(root).as_posix(),'proof':result})
+        print(config,label,'passed',flush=True)
+report={'schema_version':1,'status':'passed','completed_at':datetime.now(timezone.utc).isoformat(),'results':results}
+(root/'engine/out/chapter-play-installed-verification.json').write_text(json.dumps(report,indent=2)+'\n',encoding='utf-8')
