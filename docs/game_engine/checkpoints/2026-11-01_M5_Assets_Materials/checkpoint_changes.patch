+ GameplayAdmission& operator=(const GameplayAdmission&) = delete;
+ AdmissionResult reserve(const GameplayChangeBatch& batch, const GameplayTargetValidator& targets);
+ Result acknowledge(const GameplayAcknowledgement& acknowledgement);
+ GameplayAdmissionState state() const noexcept;
+ std::shared_ptr<const GameplayChangeBatch> next_visible() const;
+ std::shared_ptr<const GameplayChangeBatch> next_durable() const;
+private:
+ struct Impl;
+ std::unique_ptr<Impl> impl_;
+};
+}
--- prior/engine/install/0.9.0/release/include/aibs/gameplay_codec.hpp
+++ current/engine/install/0.9.0/release/include/aibs/gameplay_codec.hpp
@@ -0,0 +1,26 @@
+#pragma once
+#include <aibs/gameplay.hpp>
+#include <cstddef>
+#include <cstdint>
+#include <span>
+#include <stdexcept>
+
+namespace aibs::gameplay_codec {
+using Bytes = std::vector<std::uint8_t>;
+inline constexpr std::size_t maximum_bytes = 4 * 1024 * 1024;
+// Canonical typed little-endian envelopes. Every decoder rejects
+// trailing/truncated/noncanonical input. Invalid input throws invalid_argument.
+// Registered component versions remain explicit positive values; envelope,
+// scope/component/registry envelopes stay at 1. Old-only batches retain exact
+// version-1 bytes. Batches containing Mechanism/Quest use envelope/schema 2;
+// those families use payload 2 while original families retain payload 1.
+Bytes encode_batch(const GameplayChangeBatch& batch);
+GameplayChangeBatch decode_batch(std::span<const std::uint8_t> bytes);
+Bytes encode_component(const ComponentRecord& component);
+ComponentRecord decode_component(std::span<const std::uint8_t> bytes);
+// Registry and field order are canonicalized by type/version and field ID.
+Bytes encode_schemas(const std::vector<ComponentSchema>& schemas);
+std::vector<ComponentSchema> decode_schemas(std::span<const std::uint8_t> bytes);
+Bytes encode_scope(const GameplayScope& scope);
+GameplayScope decode_scope(std::span<const std::uint8_t> bytes);
+}
--- prior/engine/install/0.9.0/release/include/aibs/gameplay_store.hpp
+++ current/engine/install/0.9.0/release/include/aibs/gameplay_store.hpp
@@ -0,0 +1,73 @@
+#pragma once
+#include <aibs/gameplay.hpp>
+#include <filesystem>
+
+namespace aibs {
+enum class GameplayStoreStatus { committed, retry, rejected, failed };
+enum class GameplayStoreStage { before_commit, after_commit };
+// Fault/termination instrumentation runs on the connection owner. An exception
+// after COMMIT cannot revoke the durable result and is reported in its message.
+using GameplayStoreObserver = std::function<void(GameplayStoreStage)>;
+struct GameplayStoreCommit {
+ GameplayStoreStatus status = GameplayStoreStatus::failed;
+ std::string message;
+ GameplayAcknowledgement acknowledgement;
+};
+struct GameplayStoreRecovery {
+ GameplayScope scope;
+ std::uint64_t revision = 0, sequence = 0;
+ std::vector<ComponentRecord> components;
+};
+struct GameplayStoreBaseline {
+ std::uint64_t revision = 0, sequence = 0;
+ std::vector<ComponentRecord> components;
+ std::vector<std::uint8_t> legacy_checkpoint;
+};
+struct GameplayRegistryExtensionResult {
+ GameplayStoreStatus status = GameplayStoreStatus::failed;
+ std::string message;
+};
+// Synchronous, single-owner durable boundary. The save worker owns this object
+// and its SQLite connection; simulation code only sends immutable batches.
+// Complete scope keys isolate branches/contexts in a shared database. Registry
+// changes and unknown database formats require explicit migration. Recovery is
+// bounded (10000 components / 64 MiB encoded state). Receipt lifetime is not
+// capped; callers page through history with explicit item/byte bounds.
+class GameplayStore {
+public:
+ // Read-only bounded restart discovery. Unknown/foreign/corrupt databases and
+ // exhausted limits throw; missing paths are never created. This checks scope
+ // metadata only; open the selected scope with its known registry to validate
+ // the complete durable stream. maximum must be within 1..4096.
+ static std::vector<GameplayScope> list_scopes(const std::filesystem::path& path,
+                                             std::size_t maximum = 128);
+ // Inspect only canonical metadata without creating/upgrading a database.
+ static std::vector<ComponentSchema> inspect_registry(const std::filesystem::path& path,
+                                                     const GameplayScope& scope);
+ // Explicit format1->2 additive registry transaction. Existing definitions,
+ // gameplay heads, components, events, retry receipts and baseline stay intact.
+ // This result intentionally carries no gameplay acknowledgement or revision.
+ static GameplayRegistryExtensionResult extend_registry(const std::filesystem::path& path,
+    const GameplayScope& scope,const std::vector<ComponentSchema>& expected_schemas,
+    const std::vector<ComponentSchema>& target_schemas,const std::string& migration_id,
+    std::uint64_t expected_revision,std::uint64_t expected_sequence,GameplayStoreObserver observer = {});
+ GameplayStore(const std::filesystem::path& path, GameplayScope scope,
+               std::vector<ComponentSchema> schemas, GameplayStoreObserver observer = {});
+ ~GameplayStore();
+ GameplayStore(const GameplayStore&) = delete;
+ GameplayStore& operator=(const GameplayStore&) = delete;
+ GameplayStoreCommit commit(const GameplayChangeBatch& batch);
+ GameplayStoreRecovery recover() const;
+ std::optional<GameplayChangeBatch> lookup_batch(const std::string& operation_id) const;
+ // Exact read-only lookup in this store's full scope. Invalid UUIDs throw.
+ bool contains_event(const std::string& event_id) const;
+ std::vector<GameplayChangeBatch> read_batches(std::uint64_t after_revision,
+    std::size_t max_batches = 128, std::size_t max_bytes = 4 * 1024 * 1024) const;
+ GameplayStoreCommit seed(const GameplayStoreBaseline& baseline);
+ std::optional<GameplayStoreBaseline> baseline() const;
+ Result verify() const;
+private:
+ struct Impl;
+ std::unique_ptr<Impl> impl_;
+};
+}
--- prior/engine/install/0.9.0/release/include/aibs/gameplay_worker.hpp
+++ current/engine/install/0.9.0/release/include/aibs/gameplay_worker.hpp
@@ -0,0 +1,63 @@
+#pragma once
+#include <aibs/gameplay_store.hpp>
+
+namespace aibs {
+struct GameplayWorkerLimits {
+ std::size_t items=8,bytes=1024*1024;
+};
+enum class WorkerSubmitStatus { accepted,retry,rejected,backpressure,closed };
+struct WorkerSubmitResult {
+ WorkerSubmitStatus status=WorkerSubmitStatus::rejected;
+ std::string message;
+};
+struct GameplaySaveCompletion {
+ GameplayScope scope;
+ std::string operation_id;
+ std::uint64_t revision=0,sequence=0;
+ GameplayStoreCommit result;
+};
+struct GameplayWorkerState {
+ std::size_t reserved=0,queued=0,in_flight=0,completed=0,charged_items=0,charged_bytes=0;
+ bool blocked=false,closed=false,stopped=false;
+};
+// The worker exclusively owns its SQLite connection on a background thread.
+// Constructor waits for successful open/recovery or joins and propagates the
+// startup exception. No CreatorSession or mutable world crosses this boundary.
+class GameplaySaveWorker {
+public:
+ GameplaySaveWorker(const std::filesystem::path& path,GameplayScope scope,std::vector<ComponentSchema> schemas,
+                    GameplayWorkerLimits limits={},GameplayStoreObserver observer={});
+ ~GameplaySaveWorker();
+ GameplaySaveWorker(const GameplaySaveWorker&)=delete;
+ GameplaySaveWorker& operator=(const GameplaySaveWorker&)=delete;
+ // Bounded canonical preflight precedes capacity checks and defensive copying.
+ // Queue charge includes queued, in-flight and undrained completion storage.
+ // Retained exact requests retry without consuming another credit. After drain,
+ // exact retries go through SQLite's durable receipts; no unlimited ID set grows.
+ WorkerSubmitResult submit(std::shared_ptr<const GameplayChangeBatch> batch);
+ // Reserve immutable storage/credits before live world publication. A reserved
+ // entry cannot reach SQLite and blocks dispatch of all later entries.
+ WorkerSubmitResult reserve(std::shared_ptr<const GameplayChangeBatch> batch);
+ // After a prepared nonthrowing world swap, activate without allocating value
+ // data. Repeats for retained active entries succeed without another dispatch.
+ bool publish_reserved(const std::string& operation_id);
+ // Only an unpublished reservation can be canceled/refunded. No committed or
+ // already dispatched entry can be removed through this path.
+ bool cancel_reserved(const std::string& operation_id);
+ // Success releases credits. A failed attempt is delivered once but retains its
+ // batch/credit and blocks later work. Poll before explicitly retrying that head.
+ std::optional<GameplaySaveCompletion> poll();
+ Result retry_failed();
+ // Stop admission, flush in order until the first unpublished or failed entry,
+ // then join. Uncommitted work reports failure; completions remain drainable.
+ // Closing never publishes a reservation or skips its queued successors.
+ Result close();
+ GameplayWorkerState state() const;
+ // Immutable startup snapshot, not a live view of subsequent commits. Recovery
+ // has its own store limits; this bounded copy is outside pending queue credits.
+ GameplayStoreRecovery initial_state() const;
+private:
+ struct Impl;
+ std::unique_ptr<Impl> impl_;
+};
+}
