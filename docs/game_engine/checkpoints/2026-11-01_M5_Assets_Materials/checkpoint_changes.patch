+				COMMAND xcrun -sdk ${METAL_SDK_TARGET} metallib -o ${JOLT_PHYSICS_METAL_LIB} ${JOLT_PHYSICS_MTL_SHADERS}
+				DEPENDS ${JOLT_PHYSICS_MTL_SHADERS}
