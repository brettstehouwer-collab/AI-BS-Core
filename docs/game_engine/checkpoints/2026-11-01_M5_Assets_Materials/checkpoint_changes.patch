+namespace aibs {
+std::string new_uuid();
+bool is_uuid(const std::string& value) noexcept;
+struct FieldSchema { std::string id; double minimum; double maximum; bool operator==(const FieldSchema&) const = default; };
+class SchemaRegistry {
+public:
