+def module_relative(module: str) -> str:
+    if (not isinstance(module, str) or not re.fullmatch(r'native_studio(?:\.[A-Za-z_]\w*)*', module)
+            or any(part.startswith(('test_', 'sign_', 'scratch_', 'build_')) for part in module.split('.'))):
