+    "electron-is-dev": "^3.0.1",
+    "electron-updater": "^6.8.9",
+    "firebase": "^12.18.0",
+    "flexlayout-react": "^0.10.5",
+    "fountain-js": "^1.2.4",
+    "hls.js": "^1.7.1",
+    "lucide-react": "^1.33.0",
+    "react": "^19.2.8",
