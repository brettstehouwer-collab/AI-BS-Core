+environment['QT_QPA_PLATFORM'] = 'windows'
+for key in ('AI_BS_NATIVE_MANAGE_DAEMONS', 'AI_BS_NATIVE_EXIT_PROCESS_CLEANUP', 'AI_BS_NATIVE_BACKGROUND_UPDATES'):
+    environment[key] = 'false'
+started = time.monotonic()
+with (work / ('frozen_' + mode + '.stdout.log')).open('xb') as out, (work / ('frozen_' + mode + '.stderr.log')).open('xb') as err:
