+import ast,difflib,hashlib,importlib.util,json,re,shutil,subprocess,zipfile
+root=Path('C:/AI-BS');dest=root/'docs/game_engine/checkpoints/2026-11-01_M5_Persistent_Asset_Placement'
+work=root/'backups/native_game97_20261101_placement';archive=root/'backups/checkpoint_20261101_persistent_placement/AI_BS_Persistent_Placement_Source.zip'
+assert not archive.exists(),'Existing checkpoint protected'
+def git(*args):return subprocess.check_output(['git',*args],cwd=root)
+def sha(p):
+    with p.open('rb') as f:return hashlib.file_digest(f,'sha256').hexdigest()
+proof=json.loads((root/'engine/out/persistent_placement_verification.json').read_text(encoding='utf-8'));assert proof['status']=='passed'
+independent=root/'engine/out/placements97-independent-acceptance.json';assert json.loads(independent.read_text(encoding='utf-8'))['status']=='passed'
+(dest/'git_status.txt').write_bytes(git('status','--porcelain=v1','--untracked-files=all'))
+(dest/'tracked_changes.patch').write_bytes(git('diff','--binary','--','engine','native_studio/game_engine','native_studio/app.py',
+ 'native_studio/game_build_view.py','native_studio/game_build_monitor.py','native_studio/asset_release_smoke.py','native_studio/placement_release_smoke.py',
+ 'scripts/build_native_game_release.py','scripts/verify_native_creator_release.py'))
+with zipfile.ZipFile(root/'backups/checkpoint_20261101_assets_materials/AI_BS_Assets_Materials_Source.zip') as prior:
+    old=json.loads(prior.read('source_manifest.json'));old_entries={e['path']:e for e in old['files']};paths=set(old_entries)
+    # Capture all owned engine source/docs/tests, never dependency checkouts or output trees by broad recursion.
+    for folder in ('engine/include','engine/src','engine/apps','engine/tests','engine/tools','engine/scripts','engine/cmake','engine/assets','engine/examples/sdk_consumer'):
+        paths.update(p.relative_to(root).as_posix() for p in (root/folder).rglob('*') if p.is_file() and '__pycache__' not in p.parts)
