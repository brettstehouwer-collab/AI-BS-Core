+			${JOLT_PHYSICS_ROOT}/Compute/VK/IncludeVK.h
+		)
+
+		# TODO: For some reason it errors on finding dxc when we specify the dxc component to find_vulkan (and update cmake version)
+		# For now, just set it manually
+		string(REPLACE "glslc" "dxc" Vulkan_dxc_EXECUTABLE ${Vulkan_GLSLC_EXECUTABLE})
+
+		if (JPH_SHADER_DEBUG_SYMBOLS)
+			set(SPV_DEBUG_FLAGS -fspv-debug=vulkan-with-source)
+		else()
+			set(SPV_DEBUG_FLAGS "")
+		endif()
+
+		if (JPH_SHADER_OPTIMIZATION)
+			set(SPV_OPTIMIZATION_FLAGS -O3)
+		else()
+			set(SPV_OPTIMIZATION_FLAGS -Od)
+		endif()
+
+		# Compile Vulkan shaders
+		foreach(SHADER ${JOLT_PHYSICS_SHADERS})
+			string(REPLACE ".hlsl" ".spv" SPV_SHADER ${SHADER})
+			add_custom_command(OUTPUT ${SPV_SHADER}
+				# We use dxc instead of: ${Vulkan_GLSLC_EXECUTABLE} -fshader-stage=compute ${SHADER} -o ${SPV_SHADER}
+				# The glslc compiler has the following issues:
+				# - All buffers bind to slot 0. We don't want to manually specify registers so this requires going into the SPIRV code and patching it.
+				# - It automatically aligns float3 to 16 byte boundaries which wastes a lot of memory in structs. We only seem to be able to override this alignment when compiling a GLSL shader and not with HLSL.
+				COMMAND ${Vulkan_dxc_EXECUTABLE} -E main -T cs_6_0 -I Jolt/Shaders -WX -all_resources_bound -spirv -fvk-use-dx-layout ${SPV_OPTIMIZATION_FLAGS} ${SPV_DEBUG_FLAGS} ${SHADER} -Fo ${SPV_SHADER}
+				DEPENDS ${SHADER} ${JOLT_PHYSICS_SHADER_HEADERS} # Currently don't have a way to detect header dependencies, so making dependent on all
+				COMMENT "Compiling Vulkan ${SHADER}")
+			list(APPEND JOLT_PHYSICS_SPV_SHADERS ${SPV_SHADER})
+		endforeach()
+
+		# Group intermediate files
+		source_group(Intermediate FILES ${JOLT_PHYSICS_SPV_SHADERS})
+	else()
+		set(JPH_USE_VK OFF)
+	endif()
+endif()
+
+# Group source files
+source_group(TREE ${JOLT_PHYSICS_ROOT} FILES ${JOLT_PHYSICS_SRC_FILES} ${JOLT_PHYSICS_SHADERS} ${JOLT_PHYSICS_SHADER_HEADERS})
+
+# Create Jolt lib
+if (JPH_BUILD_SHARED_LIBS)
+	# Set default visibility to hidden
+	set(CMAKE_CXX_VISIBILITY_PRESET hidden)
+
+	set(JPH_LIB_TYPE SHARED)
+else()
+	set(JPH_LIB_TYPE STATIC)
+endif()
+add_library(Jolt ${JPH_LIB_TYPE} ${JOLT_PHYSICS_SRC_FILES} ${JOLT_PHYSICS_SHADERS} ${JOLT_PHYSICS_SHADER_HEADERS} ${JOLT_PHYSICS_DXIL_SHADERS} ${JOLT_PHYSICS_SPV_SHADERS} ${JOLT_PHYSICS_METAL_LIB})
+add_library(Jolt::Jolt ALIAS Jolt)
+
+if (JPH_BUILD_SHARED_LIBS)
+	if (GENERATE_DEBUG_SYMBOLS)
+		if (MSVC)
+			# MSVC specific option to enable PDB generation
+			set(CMAKE_SHARED_LINKER_FLAGS_RELEASE "${CMAKE_SHARED_LINKER_FLAGS_RELEASE} /DEBUG:FULL")
+		else()
+			# Clang/GCC option to enable debug symbol generation
+			set(CMAKE_SHARED_LINKER_FLAGS_RELEASE "${CMAKE_SHARED_LINKER_FLAGS_RELEASE} -g")
+		endif()
+	endif()
+
+	# Set linker flags for other build types to be the same as release
+	set(CMAKE_SHARED_LINKER_FLAGS_RELEASEASAN "${CMAKE_SHARED_LINKER_FLAGS_RELEASE}")
+	set(CMAKE_SHARED_LINKER_FLAGS_RELEASEUBSAN "${CMAKE_SHARED_LINKER_FLAGS_RELEASE}")
+	set(CMAKE_SHARED_LINKER_FLAGS_RELEASETSAN "${CMAKE_SHARED_LINKER_FLAGS_RELEASE}")
+	set(CMAKE_SHARED_LINKER_FLAGS_RELEASECOVERAGE "${CMAKE_SHARED_LINKER_FLAGS_RELEASE}")
+	set(CMAKE_SHARED_LINKER_FLAGS_DISTRIBUTION "${CMAKE_SHARED_LINKER_FLAGS_RELEASE}")
+
+	# Public define to instruct user code to import Jolt symbols (rather than use static linking)
+	target_compile_definitions(Jolt PUBLIC JPH_SHARED_LIBRARY)
+
+	# Private define to instruct the library to export symbols for shared linking
+	target_compile_definitions(Jolt PRIVATE JPH_BUILD_SHARED_LIBRARY)
+endif()
+
+# Use repository as include directory when building, install directory when installing
+target_include_directories(Jolt PUBLIC
+	$<BUILD_INTERFACE:${PHYSICS_REPO_ROOT}>
+	$<INSTALL_INTERFACE:include/>)
+
+# Code coverage doesn't work when using precompiled headers
+if (CMAKE_GENERATOR STREQUAL "Ninja Multi-Config" AND MSVC)
+	# The Ninja Multi-Config generator errors out when selectively disabling precompiled headers for certain configurations.
+	# See: https://github.com/jrouwe/JoltPhysics/issues/1211
+	target_precompile_headers(Jolt PRIVATE "${JOLT_PHYSICS_ROOT}/Jolt.h")
+else()
+	target_precompile_headers(Jolt PRIVATE "$<$<NOT:$<CONFIG:ReleaseCoverage>>:${JOLT_PHYSICS_ROOT}/Jolt.h>")
+endif()
+
+# Set the NDEBUG define for release builds
+target_compile_definitions(Jolt PUBLIC "$<$<CONFIG:Release,Distribution,ReleaseASAN,ReleaseUBSAN,ReleaseTSAN,ReleaseCoverage>:NDEBUG>")
+
+# ASAN and TSAN should use the default allocators
+target_compile_definitions(Jolt PUBLIC "$<$<CONFIG:ReleaseASAN,ReleaseTSAN>:JPH_DISABLE_TEMP_ALLOCATOR;JPH_DISABLE_CUSTOM_ALLOCATOR>")
+
+# Setting floating point exceptions
+if (FLOATING_POINT_EXCEPTIONS_ENABLED AND "${CMAKE_CXX_COMPILER_ID}" STREQUAL "MSVC")
+	target_compile_definitions(Jolt PUBLIC "$<$<CONFIG:Debug,Release>:JPH_FLOATING_POINT_EXCEPTIONS_ENABLED>")
+endif()
+
+# Setting the disable custom allocator flag
+if (DISABLE_CUSTOM_ALLOCATOR)
+	target_compile_definitions(Jolt PUBLIC JPH_DISABLE_CUSTOM_ALLOCATOR)
+endif()
+
+# Setting enable asserts flag
+if (USE_ASSERTS)
+	target_compile_definitions(Jolt PUBLIC JPH_ENABLE_ASSERTS)
+endif()
+
+# Setting double precision flag
+if (DOUBLE_PRECISION)
+	target_compile_definitions(Jolt PUBLIC JPH_DOUBLE_PRECISION)
+endif()
+
+# Setting to attempt cross platform determinism
+if (CROSS_PLATFORM_DETERMINISTIC)
+	target_compile_definitions(Jolt PUBLIC JPH_CROSS_PLATFORM_DETERMINISTIC)
+endif()
+
+# Setting to determine number of bits in ObjectLayer
+if (OBJECT_LAYER_BITS)
+	target_compile_definitions(Jolt PUBLIC JPH_OBJECT_LAYER_BITS=${OBJECT_LAYER_BITS})
+endif()
+
+if (USE_STD_VECTOR)
+	target_compile_definitions(Jolt PUBLIC JPH_USE_STD_VECTOR)
+endif()
+
+# Setting to periodically trace broadphase stats to help determine if the broadphase layer configuration is optimal
+if (TRACK_BROADPHASE_STATS)
+	target_compile_definitions(Jolt PUBLIC JPH_TRACK_BROADPHASE_STATS)
+endif()
+
+# Setting to periodically trace narrowphase stats to help determine which collision queries could be optimized
+if (TRACK_NARROWPHASE_STATS)
+	target_compile_definitions(Jolt PUBLIC JPH_TRACK_NARROWPHASE_STATS)
+endif()
+
+# Setting to track simulation timings per body
+if (JPH_TRACK_SIMULATION_STATS)
+	target_compile_definitions(Jolt PUBLIC JPH_TRACK_SIMULATION_STATS)
+endif()
+
+# Compile against DirectX 12
+if (JPH_USE_DX12)
+	target_compile_definitions(Jolt PUBLIC JPH_USE_DX12)
+	target_link_libraries(Jolt LINK_PUBLIC dxgi.lib d3d12.lib d3dcompiler.lib dxguid.lib)
+endif()
+
+# Compile against Vulkan
+if (JPH_USE_VK)
+	target_compile_definitions(Jolt PUBLIC JPH_USE_VK)
+
+	target_include_directories(Jolt PUBLIC ${Vulkan_INCLUDE_DIRS})
+endif()
+
+# Compile against Metal
+if (JPH_USE_MTL)
+	target_compile_definitions(Jolt PUBLIC JPH_USE_MTL)
+
+	target_link_libraries(Jolt LINK_PUBLIC "-framework Foundation -framework Metal -framework MetalKit")
+endif()
+
+# Compile CPU compute support
+if (JPH_USE_CPU_COMPUTE)
+	target_compile_definitions(Jolt PUBLIC JPH_USE_CPU_COMPUTE)
+endif()
+
+# Enable the debug renderer
+if (DEBUG_RENDERER_IN_DISTRIBUTION)
+	target_compile_definitions(Jolt PUBLIC "JPH_DEBUG_RENDERER")
+elseif (DEBUG_RENDERER_IN_DEBUG_AND_RELEASE)
+	target_compile_definitions(Jolt PUBLIC "$<$<CONFIG:Debug,Release,ReleaseASAN,ReleaseUBSAN,ReleaseTSAN>:JPH_DEBUG_RENDERER>")
+endif()
+
+# Enable the profiler
+if (JPH_USE_EXTERNAL_PROFILE)
+	set(JOLT_PROFILE_DEFINE JPH_EXTERNAL_PROFILE)
+else()
+	set(JOLT_PROFILE_DEFINE JPH_PROFILE_ENABLED)
+endif()
+if (PROFILER_IN_DISTRIBUTION)
+	target_compile_definitions(Jolt PUBLIC "${JOLT_PROFILE_DEFINE}")
+elseif (PROFILER_IN_DEBUG_AND_RELEASE)
+	target_compile_definitions(Jolt PUBLIC "$<$<CONFIG:Debug,Release,ReleaseASAN,ReleaseUBSAN,ReleaseTSAN>:${JOLT_PROFILE_DEFINE}>")
+endif()
+
+# Compile the ObjectStream class and RTTI attribute information
+if (ENABLE_OBJECT_STREAM)
+	target_compile_definitions(Jolt PUBLIC JPH_OBJECT_STREAM)
+endif()
+
+# Emit the instruction set definitions to ensure that child projects use the same settings even if they override the used instruction sets (a mismatch causes link errors)
+function(EMIT_X86_INSTRUCTION_SET_DEFINITIONS)
+	if (USE_AVX512)
+		target_compile_definitions(Jolt PUBLIC JPH_USE_AVX512)
+	endif()
+	if (USE_AVX2)
+		target_compile_definitions(Jolt PUBLIC JPH_USE_AVX2)
+	endif()
+	if (USE_AVX)
+		target_compile_definitions(Jolt PUBLIC JPH_USE_AVX)
+	endif()
+	if (USE_SSE4_1)
+		target_compile_definitions(Jolt PUBLIC JPH_USE_SSE4_1)
+	endif()
+	if (USE_SSE4_2)
+		target_compile_definitions(Jolt PUBLIC JPH_USE_SSE4_2)
+	endif()
+	if (USE_LZCNT)
+		target_compile_definitions(Jolt PUBLIC JPH_USE_LZCNT)
+	endif()
+	if (USE_TZCNT)
+		target_compile_definitions(Jolt PUBLIC JPH_USE_TZCNT)
+	endif()
+	if (USE_F16C)
+		target_compile_definitions(Jolt PUBLIC JPH_USE_F16C)
+	endif()
+	if (USE_FMADD AND NOT CROSS_PLATFORM_DETERMINISTIC)
+		target_compile_definitions(Jolt PUBLIC JPH_USE_FMADD)
+	endif()
+endfunction()
+
+# Add the compiler commandline flags to select the right instruction sets
+if ("${CMAKE_CXX_COMPILER_ID}" STREQUAL "MSVC")
+	if ("${CMAKE_VS_PLATFORM_NAME}" STREQUAL "x86" OR "${CMAKE_VS_PLATFORM_NAME}" STREQUAL "x64")
+		if (USE_AVX512)
+			target_compile_options(Jolt PUBLIC /arch:AVX512)
+		elseif (USE_AVX2)
+			target_compile_options(Jolt PUBLIC /arch:AVX2)
+		elseif (USE_AVX)
+			target_compile_options(Jolt PUBLIC /arch:AVX)
+		endif()
+		EMIT_X86_INSTRUCTION_SET_DEFINITIONS()
+	endif()
+else()
+	if (XCODE)
+		# XCode builds for multiple architectures, we can't set global flags
+	elseif (CROSS_COMPILE_ARM OR CMAKE_OSX_ARCHITECTURES MATCHES "arm64" OR "${CMAKE_SYSTEM_PROCESSOR}" STREQUAL "aarch64")
+		# ARM64 uses no special commandline flags
+	elseif (EMSCRIPTEN)
+		if (USE_WASM_SIMD)
+			# Jolt currently doesn't implement the WASM specific SIMD intrinsics so uses the SSE 4.2 intrinsics
+			# See: https://emscripten.org/docs/porting/simd.html#webassembly-simd-intrinsics
+			# Note that this does not require the browser to actually support SSE 4.2 it merely means that it can translate those instructions to WASM SIMD instructions
+			target_compile_options(Jolt PUBLIC -msimd128 -msse4.2)
+		endif()
+		if (JPH_USE_WASM64)
+			target_compile_options(Jolt PUBLIC -sMEMORY64)
+			target_link_options(Jolt PUBLIC -sMEMORY64)
+		endif()
+	elseif ("${CMAKE_SYSTEM_PROCESSOR}" STREQUAL "x86_64" OR "${CMAKE_SYSTEM_PROCESSOR}" STREQUAL "AMD64" OR "${CMAKE_SYSTEM_PROCESSOR}" STREQUAL "x86" OR "${CMAKE_SYSTEM_PROCESSOR}" STREQUAL "i386")
+		# x86 and x86_64
+		# On 32-bit builds we need to default to using SSE instructions, the x87 FPU instructions have higher intermediate precision
+		# which will cause problems in the collision detection code (everywhere where DifferenceOfProducts is used).
+
+		if (USE_AVX512)
+			target_compile_options(Jolt PUBLIC -mavx512f -mavx512vl -mavx512dq -mavx2 -mbmi -mpopcnt -mlzcnt -mf16c)
+		elseif (USE_AVX2)
+			target_compile_options(Jolt PUBLIC -mavx2 -mbmi -mpopcnt -mlzcnt -mf16c)
+		elseif (USE_AVX)
+			target_compile_options(Jolt PUBLIC -mavx -mpopcnt)
+		elseif (USE_SSE4_2)
+			target_compile_options(Jolt PUBLIC -msse4.2 -mpopcnt)
+		elseif (USE_SSE4_1)
+			target_compile_options(Jolt PUBLIC -msse4.1)
+		else()
+			target_compile_options(Jolt PUBLIC -msse2)
+		endif()
+		if (USE_LZCNT)
+			target_compile_options(Jolt PUBLIC -mlzcnt)
+		endif()
+		if (USE_TZCNT)
+			target_compile_options(Jolt PUBLIC -mbmi)
+		endif()
+		if (USE_F16C)
+			target_compile_options(Jolt PUBLIC -mf16c)
+		endif()
+		if (USE_FMADD AND NOT CROSS_PLATFORM_DETERMINISTIC)
+			target_compile_options(Jolt PUBLIC -mfma)
+		endif()
+
+		if (NOT MSVC)
+			target_compile_options(Jolt PUBLIC -mfpmath=sse)
+		endif()
+
+		EMIT_X86_INSTRUCTION_SET_DEFINITIONS()
+	endif()
+endif()
+
+# On Unix flavors we need the pthread library
+if (NOT ("${CMAKE_SYSTEM_NAME}" STREQUAL "Windows") AND NOT EMSCRIPTEN)
+	target_compile_options(Jolt PUBLIC -pthread)
+	target_link_options(Jolt PUBLIC -pthread)
+endif()
+
+if (EMSCRIPTEN)
+	# We need more than the default 64KB stack and 16MB memory
+	# In your application, specify at least -sSTACK_SIZE=1048576 -sINITIAL_MEMORY=134217728
+	# Also disable warning: running limited binaryen optimizations because DWARF info requested (or indirectly required)
+	target_link_options(Jolt PUBLIC -Wno-limited-postlink-optimizations)
+endif()
--- prior/engine/install/0.10.0/release/include/aibs/asset_scene.hpp
+++ current/engine/install/0.10.0/release/include/aibs/asset_scene.hpp
@@ -0,0 +1,35 @@
+#pragma once
+#include <aibs/assets.hpp>
+#include <aibs/scene.hpp>
+
+namespace aibs {
+struct AssetRecord {
+ std::string asset_id;
+ std::string sha256;
+ std::string file;
+};
+
+// Read-only standalone catalog. Exact ASCII/LF syntax:
+// AIBCAT 1\n<UUID> <lowercase SHA256> <same SHA256>.aibmesh\n...
+// No comments, duplicate identities/digests/paths, relative directories or
+// redirected filesystem components are accepted. No source fallback exists.
+class AssetCatalog {
+public:
+ explicit AssetCatalog(const std::filesystem::path& root);
+ const std::vector<AssetRecord>& records() const noexcept { return records_; }
+ // Each load rechecks paths, bounds, file SHA before decoding, and asset UUID.
+ // It returns a value without changing or importing any world/save document.
+ MeshAsset load(const std::string& asset_id) const;
+private:
+ std::filesystem::path root_;
+ std::vector<AssetRecord> records_;
+};
+
+// Presentation only: expands indexed triangles into the existing colored
+// vertex format. It does not alter SceneSnapshot, picking, collision or saves.
+// Positive finite scale; finite unit quaternion (1e-4 squared-norm tolerance).
+// Normals use inverse transpose scale and normalized rotation. Validation,
+// overflow or allocation failure leaves the entire destination mesh unchanged.
+void append_asset_mesh(SceneMesh& scene, const MeshAsset& asset, Vec3 center,
+                       Vec3 scale = {1,1,1}, Quaternion rotation = {});
+}
--- prior/engine/install/0.10.0/release/include/aibs/asset_store.hpp
+++ current/engine/install/0.10.0/release/include/aibs/asset_store.hpp
@@ -0,0 +1,48 @@
+#pragma once
+#include <aibs/assets.hpp>
+#include <filesystem>
+#include <span>
+#include <string>
+#include <vector>
+
+namespace aibs {
+// Project metadata contains only these persistent identities/digests. The
+// explicit store root is supplied by the owner, never serialized as a host path.
+struct AssetPackReference {
+ std::string asset_id;
+ std::string asset_sha256;
+ std::string pack_sha256;
+ bool operator==(const AssetPackReference&) const = default;
+};
+inline constexpr std::size_t asset_store_maximum_references = 64;
+inline constexpr std::size_t asset_store_maximum_unique_packs = 32;
+inline constexpr std::size_t asset_store_maximum_staged_bytes = 64u * 1024u * 1024u;
+
+void validate_asset_pack_reference(const AssetPackReference& reference);
+// Source is one exact four-file native v1 cooker pack. Store must be an existing
+// plain directory. Fresh immutable child publication; exact existing pack reuse.
+AssetPackReference adopt_asset_pack(const std::filesystem::path& source_pack,
+                                  const std::filesystem::path& store);
+// Rechecks all four file lengths/digests and the canonical manifest-derived pack
+// identity, catalog, decoded asset UUID and mesh SHA. No source fallback exists.
+MeshAsset load_stored_asset(const std::filesystem::path& store,
+                           const AssetPackReference& reference);
+// Same verified read, with the complete four-file byte charge returned only on
+// success. File lengths are checked against maximum_read_bytes before content
+// reads, so callers can enforce a deduplicated aggregate dependency budget.
+MeshAsset load_stored_asset(const std::filesystem::path& store,
+                           const AssetPackReference& reference,
+                           std::size_t* verified_pack_bytes,
+                           std::size_t maximum_read_bytes = 33u * 1024u * 1024u);
+// Copies the deduplicated requested closure to one NEW private store directory.
+// Parent exists; destination itself must not exist. At most64 input references,
+// 32 unique packs and64MiB aggregate pack bytes. No partial final publication.
+// merge_existing validates an existing private store (<=128MiB/256 packs), then
+// adds/reuses immutable pack children. Failure may retain unused verified new
+// packs, but existing packs are never changed. Publish a new snapshot only after
+// this call succeeds. No garbage collection or save-document writes occur.
+void stage_asset_packs(const std::filesystem::path& source_store,
+                       std::span<const AssetPackReference> references,
+                       const std::filesystem::path& destination_store,
+                       bool merge_existing = false);
+}
--- prior/engine/install/0.10.0/release/include/aibs/assets.hpp
+++ current/engine/install/0.10.0/release/include/aibs/assets.hpp
@@ -0,0 +1,42 @@
+#pragma once
+#include <aibs/render.hpp>
+#include <cstddef>
+#include <cstdint>
+#include <filesystem>
+#include <span>
+#include <string>
+#include <string_view>
+#include <vector>
+
+namespace aibs {
+inline constexpr std::size_t mesh_asset_max_input_bytes = 32u * 1024u * 1024u;
+inline constexpr std::size_t mesh_asset_max_vertices = 100000;
+inline constexpr std::size_t mesh_asset_max_triangles = 100000;
+inline constexpr std::size_t mesh_asset_max_materials = 64;
+
+// v1 supports opaque base color/emission. OBJ texture coordinates are checked
+// when supplied but are not retained; materials are supplied by the engine.
+struct MeshMaterial { std::string name; Vec3 base_color{1,1,1}; float emission = 0; };
+struct AssetVertex { Vec3 position; Vec3 normal; };
+struct MeshAsset {
+ std::string asset_id;
+ std::string name;
+ std::string source_sha256;
+ std::vector<AssetVertex> vertices;
+ std::vector<std::uint32_t> indices;
+ std::vector<std::uint32_t> triangle_materials;
+ std::vector<MeshMaterial> materials;
+};
+
+MeshAsset import_obj(std::string_view obj, std::span<const MeshMaterial> materials,
+                     std::string asset_id, std::string name);
+void validate_mesh_asset(const MeshAsset& asset);
+// AIBMesh1: little-endian versioned payload plus SHA-256 checksum. Encoding
+// canonicalizes signed zero; decoding rejects noncanonical negative zero.
+std::vector<std::byte> encode_mesh_asset(const MeshAsset& asset);
+MeshAsset decode_mesh_asset(std::span<const std::byte> bytes);
+std::string asset_sha256(std::span<const std::byte> bytes);
+MeshAsset load_mesh_asset(const std::filesystem::path& path);
+// Publish atomically to a new path. Existing files are never replaced.
+void save_mesh_asset(const std::filesystem::path& path, const MeshAsset& asset);
+}
--- prior/engine/install/0.10.0/release/include/aibs/chapter_viewport.hpp
+++ current/engine/install/0.10.0/release/include/aibs/chapter_viewport.hpp
@@ -0,0 +1,37 @@
+#pragma once
+#include <aibs/content_authoring.hpp>
+#include <aibs/creator_payload.hpp>
+
+namespace aibs {
+// Mode2 is an independent, immutable typed chapter projection. The content
+// budget is separate from its bounded identity envelope; no player saves exist.
+inline constexpr std::size_t chapter_viewport_maximum_bytes=creator_payload::maximum_bytes+64*1024;
+struct ChapterViewportSnapshot {
+ std::string snapshot_id;
+ CreatorScope scope;
+ std::string checkpoint_id,selected_id;
+ std::uint64_t revision=0;
+ FirstBootContent content;
+};
+inline ChapterViewportSnapshot decode_chapter_viewport_snapshot(std::span<const unsigned char> bytes){
+ using namespace creator_payload::detail;
+ ensure(bytes.size()<=chapter_viewport_maximum_bytes,"Chapter viewport envelope exceeds bound");Reader r{bytes};
+ ensure(r.number(4)==0x56424941&&r.number(2)==1&&r.number(1)==2,"Unsupported typed chapter viewport envelope");
+ auto snapshot=r.text(true);uuid(snapshot);CreatorScope scope{r.text(true),r.text(true),r.text(true)};uuid(scope.world_id);
+ auto checkpoint=r.text();uuid(checkpoint,true);const auto revision=r.number(8);auto selected=r.text();uuid(selected,true);
+ const auto size=r.number(4);ensure(size>0&&size<=creator_payload::maximum_bytes&&size==r.data.size()-r.offset,"Invalid chapter content byte length");
+ auto content=first_boot_content_decode(r.data.subspan(r.offset,static_cast<std::size_t>(size)));
+ ensure(content.definition().world_id==scope.world_id,"Chapter content world differs from viewport scope");
+ const auto rows=content_authoring_rows(content);
+ ensure(selected.empty()||std::any_of(rows.begin(),rows.end(),[&](const auto& row){return row.entity_id==selected;}),"Selected chapter UUID is absent");
+ return {std::move(snapshot),std::move(scope),std::move(checkpoint),std::move(selected),revision,std::move(content)};
+}
+inline SceneSnapshot chapter_viewport_scene(const ChapterViewportSnapshot& snapshot){
+ const auto baseline=first_boot_content_baseline(snapshot.content);
+ const GameplayStoreRecovery recovery{{snapshot.scope.project,snapshot.scope.world_id,snapshot.scope.branch,snapshot.content.definition().definition_id,GameplayContext::temporary_play},baseline.revision,baseline.sequence,baseline.components};
+ auto scene=first_boot_content_scene(recovery,snapshot.content);scene.revision=snapshot.revision;
+ std::set<std::string> authoring_ids;for(const auto& row:content_authoring_rows(snapshot.content))authoring_ids.insert(row.entity_id);
+ for(auto& object:scene.objects)object.selectable=authoring_ids.contains(object.persistent_id);
+ return scene;
+}
+}
