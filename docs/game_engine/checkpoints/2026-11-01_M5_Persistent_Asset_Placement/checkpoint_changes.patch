+import json, os, subprocess, sys, time
+
+root = Path('C:/AI-BS')
+work = root / 'backups/native_game97_20261101_placement'
+exe = root / 'native_studio/releases/v5.329.97/AI_BS_Studio/AI_BS_Studio.exe'
+mode = sys.argv[1]
+flags = {'assets': '--asset-release-smoke', 'creator': '--creator-release-smoke',
+         'monitor': '--game-build-smoke', 'placement': '--placement-release-smoke',
+         'reopen': '--placement-reopen-smoke'}
+assert mode in flags
+report = work / ('frozen_' + mode + '.json')
+assert not report.exists(), 'Preserve existing proof'
+arguments = [str(exe), flags[mode], str(report)]
+if mode == 'reopen':
+    source = work / 'frozen_placement.json'
