+ need(is_uuid(result.reference.asset_id)&&digest_text(result.reference.asset_sha256)&&
+     row.substr(102)==result.reference.asset_sha256+".aibmesh"&&row.substr(102)==mesh_name,"Catalog asset UUID/digest/basename mismatch");
