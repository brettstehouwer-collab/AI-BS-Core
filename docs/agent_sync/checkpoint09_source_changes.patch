+{
+  "name": "bs-studio",
+  "private": true,
+  "version": "5.329.98",
+  "description": "BS-Studio - Unified Broadcast & Neural Music DAW Workstation",
+  "author": "Brett Stehouwer",
+  "type": "module",
+  "main": "electron/main.js",
+  "scripts": {
+    "start": "concurrently \"npm run dev\" \"wait-on tcp:5174 && npm run electron:dev\"",
+    "dev": "vite",
+    "version:check": "node ../scripts/release-version.cjs check",
+    "prebuild": "npm run version:check",
+    "build": "vite build",
+    "lint": "oxlint",
+    "preview": "vite preview",
+    "electron:dev": "cross-env NODE_ENV=development electron .",
+    "electron:build": "npm run build && electron-builder"
+  },
+  "dependencies": {
+    "electron-is-dev": "^3.0.1",
+    "electron-updater": "^6.8.9",
+    "firebase": "^12.18.0",
+    "flexlayout-react": "^0.10.5",
+    "fountain-js": "^1.2.4",
+    "hls.js": "^1.7.1",
+    "lucide-react": "^1.33.0",
+    "react": "^19.2.8",
+    "react-dom": "^19.2.8",
+    "react-resizable-panels": "^4.12.3",
+    "tone": "^15.1.22",
+    "zustand": "^5.0.15"
+  },
+  "devDependencies": {
+    "@types/react": "^19.2.17",
+    "@types/react-dom": "^19.2.3",
+    "@vitejs/plugin-react": "^6.0.4",
+    "concurrently": "^10.0.5",
+    "cross-env": "^10.1.0",
+    "electron": "^43.4.1",
+    "electron-builder": "^26.15.3",
+    "oxlint": "^1.75.0",
+    "vite": "^8.2.0",
+    "wait-on": "^9.1.0"
+  },
+  "build": {
+    "appId": "com.aibs.bsstudio",
+    "productName": "BS-Studio",
+    "directories": {
+      "output": "dist-electron",
+      "buildResources": "build"
+    },
+    "publish": [
+      {
+        "provider": "github",
+        "owner": "brettstehouwer-collab",
+        "repo": "AI-BS-BroadcastStudio"
+      }
+    ],
+    "win": {
+      "target": [
+        {
+          "target": "nsis",
+          "arch": [
+            "x64"
+          ]
+        }
+      ],
+      "executableName": "BS-Studio",
+      "artifactName": "${productName} Setup ${version}.${ext}"
+    },
+    "nsis": {
+      "oneClick": false,
+      "perMachine": true,
+      "allowToChangeInstallationDirectory": true,
+      "createDesktopShortcut": true,
+      "createStartMenuShortcut": true,
+      "shortcutName": "BS-Studio",
+      "include": "build/installer.nsh",
+      "runAfterFinish": true,
+      "deleteAppDataOnUninstall": false,
+      "artifactName": "${productName} Setup ${version}.${ext}"
+    },
+    "files": [
+      "dist/**/*",
+      "electron/**/*",
+      "package.json"
+    ],
+    "extraResources": [
+      {
+        "from": "../backend",
+        "to": "backend",
+        "filter": [
+          "aibs_broadcast_daemon.py",
+          "aibs_broadcast_kernel.py",
+          "audio_catalog_router.py"
+        ]
+      },
+      {
+        "from": "drivers",
+        "to": "drivers",
+        "filter": [
+          "**/*"
+        ]
+      },
+      {
+        "from": "../pyppeteer_env",
+        "to": "pyppeteer_env",
+        "filter": [
+          "**/*",
+          "!**/__pycache__/*",
+          "!**/*.pyc",
+          "!**/*.log"
+        ]
+      }
+    ]
+  }
+}
