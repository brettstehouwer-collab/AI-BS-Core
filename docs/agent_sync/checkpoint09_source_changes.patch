+def validate_build(work: Path) -> dict:
+    work = plain(work, ROOT / 'backups')
+    plan = json.loads((work / 'plan.json').read_text(encoding='utf-8'))
+    if plan['work'] != str(work) or plan['builderSha256'] != digest(Path(__file__)):
