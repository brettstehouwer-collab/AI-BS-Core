+           {'translation':[0,.25,0],'children':list(range(4,67))}]
+    globals=[identity() for _ in range(67)];globals[1]=trs((.3,0,.1));globals[2]=mul(globals[1],trs((.2,.1,0),(1.1,.9,1),2,.12));globals[3]=mul(globals[2],trs((0,.25,0)))
