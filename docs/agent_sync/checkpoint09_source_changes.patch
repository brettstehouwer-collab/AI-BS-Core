+    # shape. The ignored mesh transform includes a reflection/nonuniform scale.
+    asym=Fixture(); B=trs((.15,-.08,.2),(1.2,.8,1.1),1,.17)
+    nodes=[{'mesh':0,'skin':0,'translation':[9,4,2],'scale':[-2,3,.5]},
+           {'translation':[.3,0,.1],'children':[2]},
