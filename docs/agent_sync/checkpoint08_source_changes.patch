+[build-system]
+requires = ["setuptools>=68.0", "wheel"]
+build-backend = "setuptools.build_meta"
+
+[project]
+name = "google-antigravity"
+version = "0.1.6"
+description = "Google Antigravity SDK for building AI agents"
+readme = "README.md"
+license = {text = "Apache-2.0"}
+requires-python = ">=3.10"
+authors = [{name = "Google LLC"}]
+classifiers = [
+    "Development Status :: 3 - Alpha",
+    "Intended Audience :: Developers",
+    "License :: OSI Approved :: Apache Software License",
+    "Programming Language :: Python :: 3",
+    "Programming Language :: Python :: 3.10",
+    "Programming Language :: Python :: 3.11",
+    "Programming Language :: Python :: 3.12",
+    "Programming Language :: Python :: 3.13",
+]
+dependencies = [
+    "absl-py",
+    "google-genai>=1.0",
+    "mcp>=1.0",
+    "pydantic>=2.0",
+    "uvicorn>=0.46",
+    "websockets>=12.0",
+    "protobuf>=4.25",
+]
+
+[project.optional-dependencies]
+dev = ["pytest>=7.0"]
+otel = [
+    "opentelemetry-api",
+    "opentelemetry-sdk",
+]
+
+[project.urls]
+Homepage = "https://github.com/Google-Antigravity/antigravity-sdk-python"
+
+# The Copybara export places the SDK source at the repo root under the
+# google/antigravity/ namespace package. setuptools auto-discovers all
+# google.antigravity.* subpackages.
+[tool.setuptools.packages.find]
+include = ["google*"]
+
+# Include the pre-compiled Go binary in the wheel.
+# The release script places the platform-appropriate binary at
+# google/antigravity/bin/localharness before building each wheel.
+[tool.setuptools.package-data]
+"google.antigravity.bin" = ["*"]
+
+
+# ---------------------------------------------------------------------------
+# Linter configuration
+# ---------------------------------------------------------------------------
+# Exclude sandbox virtual-environments and any site-packages directories so
+# linters never analyse third-party library source (e.g. torch/distributed).
+
+[tool.ruff]
+line-length = 120
+exclude = [
+    ".git",
+    "__pycache__",
+    "build",
+    "dist",
+    "*.egg-info",
+    "sandbox",
+    "pyppeteer_env",
+    "**/site-packages/**",
+    "**/*_env/**",
+]
+
+[tool.ruff.lint]
+# E501 = line too long; suppress globally since 3rd-party code triggers it.
+ignore = ["E501"]
+
+[tool.flake8]
+max-line-length = 120
+exclude = [
+    ".git",
+    "__pycache__",
+    "build",
+    "dist",
+    "sandbox",
+    "pyppeteer_env",
+    "**/site-packages",
+    "**/*_env",
+]
+
+[tool.pyright]
+include = ["backend", "core", "modules", "commercial_gateway", "clients", "tools"]
+extraPaths = ["backend", "."]
+
+
+[tool.pylint.main]
+ignore-paths = [
+    ".*site-packages.*",
+    "sandbox.*",
+    "pyppeteer_env.*",
+    ".*_env[/\\\\].*",
+]
+
+[tool.pylint.format]
+max-line-length = 120
+
+[tool.pylint."messages control"]
+# Suppress missing-import noise for packages not on the project interpreter path.
+disable = [
+    "import-error",
+]
