+    } finally {
+      setIsUpdatingAutonomy(false);
+    }
+  };
+
+  // 8. Emergency Halt
+  const handleEmergencyHalt = async () => {
+    if (!window.confirm('⚠️ EMERGENCY HALT: Revoke ALL pending actions and enforce SAFE autonomy mode?')) return;
+    setIsHalting(true);
