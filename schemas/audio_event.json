{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AudioEventSchema",
  "type": "object",
  "properties": {
    "track_id": { "type": "string" },
    "note": { "type": "string" },
    "step": { "type": "integer" },
    "duration": { "type": "number" },
    "velocity": { "type": "number" },
    "bpm": { "type": "integer" },
    "pattern_id": { "type": "integer" }
  },
  "required": ["track_id", "note", "step"]
}
