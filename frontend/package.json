{
  "name": "ai-bs-frontend",
  "version": "5.296.0",
  "description": "AI-BS Sovereign Intelligence Studio",
  "author": "Brett Stehouwer / Stehouwer Publishing",
  "private": true,
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite --host --port 5173 --strictPort",
    "sync-mirrors": "python scripts/sync_mirrors.py",
    "verify:mirrors": "powershell -ExecutionPolicy Bypass -File ../scripts/verify-mirror-parity.ps1",
    "build": "npm run sync-mirrors && vite build",
    "preview": "vite preview",
    "electron:start": "electron .",
    "build:exe": "npm run build && electron-builder --win",
    "build:dir": "npm run build && electron-builder --win --dir",
    "lint": "eslint src --ext js,jsx",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/cli": "^8.4.2",
    "@capacitor/core": "^8.4.2",
    "@capacitor/ios": "^8.5.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@monaco-editor/react": "^4.4.6",
    "@xyflow/react": "^12.11.1",
    "date-fns": "^4.4.0",
    "electron-updater": "^6.8.9",
    "firebase": "^12.16.0",
    "flexlayout-react": "^0.10.5",
    "fountain-js": "^1.2.4",
    "hls.js": "^1.6.16",
    "lucide-react": "^1.33.0",
    "react": "^18.3.1",
    "react-big-calendar": "^1.20.0",
    "react-dom": "^18.3.1",
    "react-grid-layout": "^2.2.4",
    "react-markdown": "^9.0.0",
    "react-resizable-panels": "^4.12.2",
    "react-syntax-highlighter": "^15.5.0",
    "recharts": "^3.10.1",
    "remark-gfm": "^3.0.1",
    "tone": "^15.1.22",
    "uuid": "^14.0.1",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@babel/plugin-syntax-dynamic-import": "^7.8.3",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.5.5",
    "compression": "^1.7.4",
    "electron": "^31.4.0",
    "electron-builder": "^26.0.0",
    "firebase-tools": "^15.24.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "terser": "^5.49.0",
    "vite": "^5.4.1"
  },
  "build": {
    "appId": "com.aibs.sovereignstudio",
    "productName": "AI-BS Sovereign Studio",
    "directories": {
      "output": "desktop-build"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../backend/dist/brain_backend",
        "to": "brain_backend",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../go-core",
        "to": "go-core",
        "filter": [
          "aibs_engine.exe"
        ]
      },
      {
        "from": "../go-core",
        "to": "updater",
        "filter": [
          "aibs_updater.exe"
        ]
      }
    ]
  }
}