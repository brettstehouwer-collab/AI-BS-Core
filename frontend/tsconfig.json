{
  "compilerOptions": {
    "target": "ESNext",
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ESNext"
    ],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "allowJs": true,
    "checkJs": true,
    "types": [
      "vite/client"
    ],
    "paths": {
      "/src/*": [
        "./src/*"
      ],
      "/utils/*": [
        "./utils/*"
      ],
      "/firebase.js": [
        "./firebase.js"
      ],
      "/components/*": [
        "./components/*"
      ],
      "/types/*": [
        "./types/*"
      ],
      "react": [
        "./node_modules/@types/react/index.d.ts"
      ],
      "react/*": [
        "./node_modules/@types/react/*"
      ],
      "react-dom": [
        "./node_modules/@types/react-dom/index.d.ts"
      ],
      "react-dom/*": [
        "./node_modules/@types/react-dom/*"
      ],
      "react-syntax-highlighter": [
        "./node_modules/@types/react-syntax-highlighter/index.d.ts"
      ],
      "react-syntax-highlighter/*": [
        "./node_modules/@types/react-syntax-highlighter/*"
      ],
      "three": [
        "./node_modules/@types/three/index.d.ts"
      ],
      "three/*": [
        "./node_modules/@types/three/*"
      ],
      "react-big-calendar": [
        "./node_modules/@types/react-big-calendar/index.d.ts"
      ]
    }
  },
  "include": [
    "main.jsx",
    "App.jsx",
    "src/writer_main.jsx",
    "public/analytics.js",
    "public/ghost_preload.js",
    "types/aibs.d.ts"
  ],
  "files": [
    "utils/FDXSerializer.js",
    "components/ChatToolControlBar.jsx",
    "components/ComfyUIRenderWidget.jsx",
    "components/ComfyUIWorkflowTrigger.jsx",
    "components/SHMTelemetryWidget.jsx",
    "components/SplitPaneIDEWorkspace.jsx",
    "components/VectorVaultManager.jsx",
    "components/useSHMTelemetry.js",
    "src/BullshitKnowledgeSuite.jsx",
    "src/BullshitTelemetrySuite.jsx",
    "src/components/ArtifactRenderer.jsx"
  ]
}
