"""AI-BS Autonomous Self-Healing Closed Loop & Error Recovery Sentinel.

Operational Capabilities:
1. Event-Driven Incident Interception: Subscribes to NATS error streams ('aibs.errors.>')
   and background test/daemon exit monitors.
2. Forensic Diagnostic Extraction: Parses Python tracebacks and pytest failure logs,
   pinpointing source file paths, line numbers, and error signatures.
3. Multi-Model Surgical Patch Generation: Interfaces with MoE Specialist Router
   (qwen2.5-coder:latest on Port 11434) to generate minimal, safe unified replacement chunks.
4. Non-Destructive Backup & Rollback: Creates byte-for-byte snapshots in .aibs_backups/
   prior to file mutations, guaranteeing instantaneous rollback on test regressions.
5. AST & Syntax Gatekeeper: Asserts ast.parse and py_compile prior to test execution.
6. Subprocess Test Verification: Executes pytest against affected modules in an isolated runner.
7. Anti-Recursion Circuit Breaker: Limits automated repair attempts to 2 tries per unique
   error signature within a 10-minute cooldown window, preventing disk thrashing.
"""

from __future__ import annotations

import ast
import asyncio
import datetime
import hashlib
import json
import logging
import os
import py_compile
import re
import shutil
import sqlite3
import subprocess
import sys
import time
from dataclasses import asdict, dataclass
from pathlib import Path
from typing import Any, Dict, List, Optional, Tuple

logger = logging.getLogger("AIBS_SelfHealingSentinel")
logger.setLevel(logging.INFO)

_BACKEND_DIR = Path(__file__).resolve().parent.parent
_ROOT_DIR = _BACKEND_DIR.parent
_BACKUPS_DIR = _ROOT_DIR / ".aibs_backups"
_DB_PATH = _BACKEND_DIR / "self_healing_incidents.db"


@dataclass
class IncidentReport:
    incident_id: str
    timestamp: str
    error_signature: str
    file_path: str
    line_number: int
    error_type: str
    error_message: str
    status: str  # PENDING, APPLIED, VERIFIED, REVERTED, BLOCKED
    patch_summary: str
    retry_count: int
    test_result: str

    def to_dict(self) -> Dict[str, Any]:
        return asdict(self)


class SelfHealingSentinel:
    """Master Autonomous Self-Healing & Diagnostic Recovery Engine."""

    _instance: Optional[SelfHealingSentinel] = None

    def __new__(cls, *args, **kwargs) -> SelfHealingSentinel:
        if cls._instance is None:
            cls._instance = super().__new__(cls)
            cls._instance._initialized = False
        return cls._instance

    def __init__(self, db_path: Optional[Path] = None, backup_dir: Optional[Path] = None) -> None:
        if getattr(self, "_initialized", False):
            return

        self.db_path = db_path or _DB_PATH
        self.backup_dir = backup_dir or _BACKUPS_DIR
        self.backup_dir.mkdir(parents=True, exist_ok=True)

        # In-memory circuit breaker tracker: {error_sig: [timestamps]}
        self._circuit_history: Dict[str, List[float]] = {}
        self.max_retries = 2
        self.cooldown_seconds = 600.0  # 10 minutes

        self._init_db()
        self._initialized = True
        logger.info("AI-BS Self-Healing Sentinel online (DB: %s)", self.db_path)

    def _init_db(self) -> None:
        conn = sqlite3.connect(str(self.db_path), check_same_thread=False)
        try:
            with conn:
                conn.execute(
                    """
                    CREATE TABLE IF NOT EXISTS incidents (
                        id INTEGER PRIMARY KEY AUTOINCREMENT,
                        incident_id TEXT UNIQUE,
                        timestamp TEXT,
                        error_signature TEXT,
                        file_path TEXT,
                        line_number INTEGER,
                        error_type TEXT,
                        error_message TEXT,
                        status TEXT,
                        patch_summary TEXT,
                        retry_count INTEGER,
                        test_result TEXT
                    )
                    """
                )
        finally:
            conn.close()

    def parse_traceback(self, error_text: str) -> Optional[Dict[str, Any]]:
        """Extracts file, line number, exception type, and message from a Python traceback."""
        if not error_text or not isinstance(error_text, str):
            return None

        # Look for standard Python traceback patterns: File "...", line X, in ...
        matches = list(re.finditer(r'File\s+"([^"]+)",\s+line\s+(\d+)(?:,\s+in\s+([^\n]+))?', error_text))
        if not matches:
            return None

        # Filter for files within the workspace, prioritizing non-site-packages
        target_match = None
        for m in reversed(matches):
            fpath = m.group(1)
            if "site-packages" not in fpath and "lib\\runpy.py" not in fpath:
                target_match = m
                break

        if not target_match:
            target_match = matches[-1]

        file_str = target_match.group(1)
        line_no = int(target_match.group(2))

        # Extract exception line at the end
        lines = [ln.strip() for ln in error_text.strip().split("\n") if ln.strip()]
        last_line = lines[-1] if lines else "UnknownError"
        
        err_type = "Exception"
        err_msg = last_line
        if ":" in last_line:
            parts = last_line.split(":", 1)
            err_type = parts[0].strip()
            err_msg = parts[1].strip()

        # Compute deterministic 12-char error signature
        sig_raw = f"{Path(file_str).name}:{line_no}:{err_type}"
        error_signature = hashlib.sha256(sig_raw.encode("utf-8")).hexdigest()[:12]

        return {
            "file_path": file_str,
            "line_number": line_no,
            "error_type": err_type,
            "error_message": err_msg,
            "error_signature": error_signature,
        }

    def parse_test_failure(self, test_output: str) -> Optional[Dict[str, Any]]:
        """Extracts file and failure details from pytest failure outputs."""
        if not test_output:
            return None

        # Pattern: FAILED path/to/test.py::test_name - ErrorType: message
        m = re.search(r"FAILED\s+([^:]+)::(\w+)\s+-\s+([^:\n]+)(?::\s+([^\n]+))?", test_output)
        if m:
            test_file = m.group(1)
            err_type = m.group(3).strip()
            err_msg = (m.group(4) or "").strip()
            sig_raw = f"{Path(test_file).name}:{err_type}"
            error_signature = hashlib.sha256(sig_raw.encode("utf-8")).hexdigest()[:12]
            return {
                "file_path": str(_ROOT_DIR / test_file) if not os.path.isabs(test_file) else test_file,
                "line_number": 1,
                "error_type": err_type,
                "error_message": err_msg or f"Pytest failure in {m.group(2)}",
                "error_signature": error_signature,
            }

        return self.parse_traceback(test_output)

    def is_circuit_broken(self, error_signature: str) -> bool:
        """Returns True if the signature has exceeded max_retries within cooldown window."""
        now = time.time()
        history = self._circuit_history.get(error_signature, [])
        active_attempts = [t for t in history if now - t < self.cooldown_seconds]
        self._circuit_history[error_signature] = active_attempts
        return len(active_attempts) >= self.max_retries

    def record_attempt(self, error_signature: str) -> int:
        now = time.time()
        if error_signature not in self._circuit_history:
            self._circuit_history[error_signature] = []
        self._circuit_history[error_signature].append(now)
        return len(self._circuit_history[error_signature])

    def create_backup(self, target_file: Path) -> Path:
        """Creates an exact byte copy of target_file in .aibs_backups."""
        ts = datetime.datetime.now().strftime("%Y%m%d_%H%M%S_%f")
        backup_name = f"{target_file.name}.{ts}.bak"
        backup_path = self.backup_dir / backup_name
        shutil.copy2(target_file, backup_path)
        logger.info("Created surgical backup: %s", backup_path)
        return backup_path

    def restore_backup(self, backup_path: Path, target_file: Path) -> bool:
        """Restores a backup cleanly over target_file."""
        if not backup_path.exists():
            logger.error("Backup file not found: %s", backup_path)
            return False
        shutil.copy2(backup_path, target_file)
        logger.warning("Restored target file from backup: %s -> %s", backup_path, target_file)
        return True

    def validate_syntax(self, target_file: Path) -> Tuple[bool, str]:
        """Validates that target_file compiles cleanly with Python AST and bytecode."""
        if not target_file.exists():
            return False, f"File does not exist: {target_file}"

        try:
            content = target_file.read_text(encoding="utf-8")
            ast.parse(content, filename=str(target_file))
        except SyntaxError as e:
            return False, f"AST SyntaxError: line {e.lineno}: {e.msg}"
        except Exception as e:
            return False, f"AST Parse Error: {e}"

        try:
            py_compile.compile(str(target_file), doraise=True)
        except py_compile.PyCompileError as e:
            return False, f"Bytecode Compilation Error: {e.msg}"

        return True, "AST & Bytecode Syntax OK"

    def run_verification_tests(self, test_target: Optional[str] = None) -> Tuple[bool, str]:
        """Runs pytest on targeted test file or directory with timeout protection."""
        cmd = [sys.executable, "-m", "pytest"]
        if test_target:
            cmd.append(test_target)
        else:
            cmd.append("native_studio/test_native_studio.py")
        cmd.extend(["-v", "--maxfail=1"])

        try:
            proc = subprocess.run(
                cmd,
                cwd=str(_ROOT_DIR),
                capture_output=True,
                text=True,
                timeout=45,
            )
            output = proc.stdout + "\n" + proc.stderr
            return (proc.returncode == 0), output
        except subprocess.TimeoutExpired:
            return False, "Verification timeout expired (45s)"
        except Exception as e:
            return False, f"Verification execution failed: {e}"

    async def generate_surgical_patch(
        self,
        target_file: Path,
        line_number: int,
        error_message: str,
        context_radius: int = 15,
    ) -> Optional[Dict[str, str]]:
        """Asks the MoE code specialist (qwen2.5-coder:latest) to generate a surgical diff."""
        if not target_file.exists():
            return None

        lines = target_file.read_text(encoding="utf-8", errors="replace").splitlines()
        total_lines = len(lines)
        start_idx = max(0, line_number - context_radius - 1)
        end_idx = min(total_lines, line_number + context_radius)

        snippet = "\n".join(
            f"{i + 1}: {lines[i]}" for i in range(start_idx, end_idx)
        )

        prompt = f"""You are the AI-BS Sovereign Self-Healing Sentinel.
A Python runtime error occurred in {target_file.name} around line {line_number}.

Error Message:
{error_message}

Surrounding Code:
```python
{snippet}
```

Instructions:
1. Identify the bug causing this error.
2. Produce a minimal, targeted fix.
3. Respond ONLY with a valid JSON object matching this schema (no markdown formatting, no conversational preamble):
{{
  "analysis": "Short 1-sentence root cause",
  "target_content": "Exact lines of code from the original snippet to replace",
  "replacement_content": "Exact new replacement lines of code"
}}
"""

        try:
            from backend.core.sovereign_reasoning.moe_specialist_router import (
                SpecialistDomain,
                moe_router,
            )
            res = await moe_router.dispatch(
                prompt=prompt,
                system_prompt="You are an autonomous code repair engine. You must output valid JSON only.",
                domain_hint=SpecialistDomain.CODE.value,
                temperature=0.2,
            )
            raw_text = res.get("response", "").strip()

            # Strip markdown json blocks if present
            clean_json = re.sub(r"^```(?:json)?\s*|\s*```$", "", raw_text, flags=re.MULTILINE).strip()
            patch_data = json.loads(clean_json)
            if "target_content" in patch_data and "replacement_content" in patch_data:
                return patch_data
        except Exception as e:
            logger.error("MoE patch generation error: %s", e)

        return None

    def apply_patch(self, target_file: Path, target_content: str, replacement_content: str) -> bool:
        """Applies a single-block surgical replacement to target_file."""
        if not target_file.exists():
            return False

        orig = target_file.read_text(encoding="utf-8")
        if target_content not in orig:
            # Fallback: try stripping leading/trailing whitespace lines
            t_strip = target_content.strip()
            if t_strip in orig:
                updated = orig.replace(t_strip, replacement_content.strip(), 1)
                target_file.write_text(updated, encoding="utf-8")
                return True
            logger.error("Target content not found in %s", target_file)
            return False

        updated = orig.replace(target_content, replacement_content, 1)
        target_file.write_text(updated, encoding="utf-8")
        return True

    async def heal_incident(
        self,
        error_text: str,
        test_target: Optional[str] = None,
    ) -> Dict[str, Any]:
        """Executes the full closed-loop self-healing sequence."""
        diag = self.parse_test_failure(error_text) or self.parse_traceback(error_text)
        if not diag:
            return {"status": "SKIPPED", "reason": "No actionable file/line traceback found"}

        sig = diag["error_signature"]
        fpath = Path(diag["file_path"])
        line_no = diag["line_number"]
        err_msg = diag["error_message"]
        err_type = diag["error_type"]

        incident_id = f"inc_{sig}_{int(time.time())}"
        now_iso = datetime.datetime.now().isoformat()

        # Circuit breaker check
        if self.is_circuit_broken(sig):
            logger.warning("Circuit breaker tripped for signature %s. Blocking repair to prevent thrashing.", sig)
            report = IncidentReport(
                incident_id=incident_id,
                timestamp=now_iso,
                error_signature=sig,
                file_path=str(fpath),
                line_number=line_no,
                error_type=err_type,
                error_message=err_msg,
                status="BLOCKED",
                patch_summary="Circuit breaker active (>2 attempts in 10m)",
                retry_count=len(self._circuit_history.get(sig, [])),
                test_result="SKIPPED",
            )
            self._save_incident(report)
            return report.to_dict()

        retry_count = self.record_attempt(sig)

        if not fpath.exists():
            return {"status": "FAILED", "reason": f"File not found: {fpath}"}

        # Step 1: Create Backup
        backup_path = self.create_backup(fpath)

        # Step 2: Generate Surgical Patch via MoE Router
        patch_info = await self.generate_surgical_patch(fpath, line_no, err_msg)
        if not patch_info:
            report = IncidentReport(
                incident_id=incident_id,
                timestamp=now_iso,
                error_signature=sig,
                file_path=str(fpath),
                line_number=line_no,
                error_type=err_type,
                error_message=err_msg,
                status="FAILED",
                patch_summary="MoE could not synthesize a valid JSON patch",
                retry_count=retry_count,
                test_result="SKIPPED",
            )
            self._save_incident(report)
            return report.to_dict()

        # Step 3: Apply Patch
        applied = self.apply_patch(
            fpath,
            patch_info["target_content"],
            patch_info["replacement_content"],
        )
        if not applied:
            self.restore_backup(backup_path, fpath)
            report = IncidentReport(
                incident_id=incident_id,
                timestamp=now_iso,
                error_signature=sig,
                file_path=str(fpath),
                line_number=line_no,
                error_type=err_type,
                error_message=err_msg,
                status="REVERTED",
                patch_summary="Failed to match target_content in file",
                retry_count=retry_count,
                test_result="SKIPPED",
            )
            self._save_incident(report)
            return report.to_dict()

        # Step 4: Validate Syntax (AST & Bytecode)
        syntax_ok, syntax_msg = self.validate_syntax(fpath)
        if not syntax_ok:
            logger.error("Patched file failed syntax check: %s. Reverting immediately.", syntax_msg)
            self.restore_backup(backup_path, fpath)
            report = IncidentReport(
                incident_id=incident_id,
                timestamp=now_iso,
                error_signature=sig,
                file_path=str(fpath),
                line_number=line_no,
                error_type=err_type,
                error_message=err_msg,
                status="REVERTED",
                patch_summary=f"Syntax validation failed: {syntax_msg}",
                retry_count=retry_count,
                test_result="SYNTAX_ERROR",
            )
            self._save_incident(report)
            return report.to_dict()

        # Step 5: Run Verification Tests
        test_passed, test_output = self.run_verification_tests(test_target)
        if not test_passed:
            logger.warning("Verification tests failed after patch. Reverting file to pre-patch state.")
            self.restore_backup(backup_path, fpath)
            report = IncidentReport(
                incident_id=incident_id,
                timestamp=now_iso,
                error_signature=sig,
                file_path=str(fpath),
                line_number=line_no,
                error_type=err_type,
                error_message=err_msg,
                status="REVERTED",
                patch_summary=f"Patch reverted: tests failed: {test_output[:200]}",
                retry_count=retry_count,
                test_result=test_output[:500],
            )
            self._save_incident(report)
            return report.to_dict()

        # Success!
        logger.info("Self-healing patch verified and committed for incident %s!", incident_id)
        report = IncidentReport(
            incident_id=incident_id,
            timestamp=now_iso,
            error_signature=sig,
            file_path=str(fpath),
            line_number=line_no,
            error_type=err_type,
            error_message=err_msg,
            status="VERIFIED",
            patch_summary=patch_info.get("analysis", "Autonomous surgical fix applied"),
            retry_count=retry_count,
            test_result="PASS",
        )
        self._save_incident(report)

        # Broadcast via NATS if broker available
        self._broadcast_incident(report)

        return report.to_dict()

    def _save_incident(self, report: IncidentReport) -> None:
        conn = sqlite3.connect(str(self.db_path), check_same_thread=False)
        try:
            with conn:
                conn.execute(
                    """
                    INSERT INTO incidents (
                        incident_id, timestamp, error_signature, file_path,
                        line_number, error_type, error_message, status,
                        patch_summary, retry_count, test_result
                    ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
                    """,
                    (
                        report.incident_id,
                        report.timestamp,
                        report.error_signature,
                        report.file_path,
                        report.line_number,
                        report.error_type,
                        report.error_message,
                        report.status,
                        report.patch_summary,
                        report.retry_count,
                        report.test_result,
                    ),
                )
        except Exception as e:
            logger.error("Failed to save incident: %s", e)
        finally:
            conn.close()

    def _broadcast_incident(self, report: IncidentReport) -> None:
        try:
            from backend.core.aibs_nats_broker import get_nats_broker
            broker = get_nats_broker()
            payload = json.dumps(report.to_dict()).encode("utf-8")
            broker.publish("aibs.sentinel.incidents", payload)
        except Exception:
            pass

    def get_recent_incidents(self, limit: int = 20) -> List[Dict[str, Any]]:
        conn = sqlite3.connect(str(self.db_path), check_same_thread=False)
        conn.row_factory = sqlite3.Row
        try:
            cur = conn.cursor()
            cur.execute(
                "SELECT * FROM incidents ORDER BY id DESC LIMIT ?",
                (limit,),
            )
            return [dict(r) for r in cur.fetchall()]
        finally:
            conn.close()


# Global Singleton accessor
_sentinel: Optional[SelfHealingSentinel] = None


def get_self_healing_sentinel() -> SelfHealingSentinel:
    global _sentinel
    if _sentinel is None:
        _sentinel = SelfHealingSentinel()
    return _sentinel
