# Deliberately pinned source and profile. No host-specific AVX requirements.
include(FetchContent)
foreach(option IN ITEMS USE_SSE4_1 USE_SSE4_2 USE_AVX USE_AVX2 USE_AVX512
    USE_LZCNT USE_TZCNT USE_F16C USE_FMADD INTERPROCEDURAL_OPTIMIZATION
    OVERRIDE_CXX_FLAGS FLOATING_POINT_EXCEPTIONS_ENABLED JPH_BUILD_SHARED_LIBS
    USE_STATIC_MSVC_RUNTIME_LIBRARY DEBUG_RENDERER_IN_DEBUG_AND_RELEASE
    DEBUG_RENDERER_IN_DISTRIBUTION PROFILER_IN_DEBUG_AND_RELEASE
    PROFILER_IN_DISTRIBUTION ENABLE_ALL_WARNINGS JPH_USE_DX12 JPH_USE_VK
    JPH_USE_MTL JPH_USE_CPU_COMPUTE)
  set(${option} OFF CACHE BOOL "AI-BS pinned Jolt build profile" FORCE)
endforeach()
set(CPP_EXCEPTIONS_ENABLED ON CACHE BOOL "AI-BS allocation failures propagate" FORCE)
set(ENABLE_INSTALL ON CACHE BOOL "Ship pinned Jolt with the installed AI-BS SDK" FORCE)
FetchContent_Declare(JoltSource
  URL https://codeload.github.com/jrouwe/JoltPhysics/zip/e77f175595e64cb44218cc9d9d56fc365ad0e36a
  URL_HASH SHA256=ff13202d21a7a09efea72534a0a041cd4971cb9ac66b53262275881387cc6871
  DOWNLOAD_EXTRACT_TIMESTAMP FALSE
  SOURCE_SUBDIR Build)
FetchContent_MakeAvailable(JoltSource)
install(FILES ${CMAKE_CURRENT_LIST_DIR}/../third_party/Jolt-LICENSE.txt DESTINATION share/AIBS/licenses)
