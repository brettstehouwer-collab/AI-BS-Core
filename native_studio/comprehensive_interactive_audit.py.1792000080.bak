    sys.path.insert(0, str(ROOT_DIR))
if str(STUDIO_DIR) not in sys.path:
    sys.path.insert(0, str(STUDIO_DIR))

# Safe modal & process mocks to prevent blocking or runaway processes during automated sweeps
def _mock_modal_dialogs_and_processes():
    QDialog.exec = lambda self: int(QDialog.DialogCode.Accepted)
    QDialog.open = lambda self: None
    QFileDialog.getOpenFileName = lambda *a, **k: (str(ROOT_DIR / "version.txt"), "All Files (*.*)")
    QFileDialog.getSaveFileName = lambda *a, **k: (str(ROOT_DIR / "saved_test.txt"), "All Files (*.*)")
    QFileDialog.getExistingDirectory = lambda *a, **k: str(ROOT_DIR)
    QMessageBox.exec = lambda *a, **k: int(QMessageBox.StandardButton.Ok)
    QMessageBox.question = staticmethod(lambda *a, **k: QMessageBox.StandardButton.Yes)
    QMessageBox.information = staticmethod(lambda *a, **k: QMessageBox.StandardButton.Ok)
    QMessageBox.warning = staticmethod(lambda *a, **k: QMessageBox.StandardButton.Ok)
    QMessageBox.critical = staticmethod(lambda *a, **k: QMessageBox.StandardButton.Ok)
    QInputDialog.getText = staticmethod(lambda *a, **k: ("AI-BS Automated Test", True))
    QInputDialog.getInt = staticmethod(lambda *a, **k: (1, True))
    QColorDialog.getColor = staticmethod(lambda *a, **k: Qt.GlobalColor.cyan)
    QFontDialog.getFont = staticmethod(lambda *a, **k: (None, True))

    from PyQt6.QtWidgets import QMenu
    QMenu.exec = lambda *a, **k: None
    QMenu.popup = lambda *a, **k: None

    from PyQt6.QtCore import QProcess
    QProcess.start = lambda self, *a, **k: None

    orig_popen = subprocess.Popen
    class SafePopen(orig_popen):
        def __init__(self, args, *a, **k):
            cmd_str = str(args)
            if any(target in cmd_str.lower() for target in ("october7", "steam", ".bat", "cmd.exe", "powershell.exe", "obs64", "pause")):
                self.pid = 99999
                self.returncode = 0
                self.args = args
                self.stdin = None
                self.stdout = None
                self.stderr = None
                return
            super().__init__(args, *a, **k)
        def poll(self): return 0
        def wait(self, timeout=None): return 0
        def communicate(self, input=None, timeout=None): return (b"", b"")
        def terminate(self): pass
        def kill(self): pass
    subprocess.Popen = SafePopen
    os.system = lambda cmd: 0

    try:
        from native_studio.executive_cockpit_full import ExecutiveCockpitFullView
        ExecutiveCockpitFullView._stream_ollama = lambda self, model, prompt: (
            self.token_received.emit(f"[AUDIT PASS] Prompt processed: {prompt}\n"),
            self.stream_finished.emit()
        )
    except Exception:
        pass



