def _is_offscreen_audit() -> bool:
    """Returns True when running inside the headless QTest verification harness."""
    return os.environ.get("QT_QPA_PLATFORM", "").lower() == "offscreen"


def _safe_info_dialog(parent: QWidget, title: str, message: str, warn: bool = False) -> None:
    """Displays a dialog in interactive mode or logs non-blockingly during offscreen QTest audits."""
    if _is_offscreen_audit():
        return
    if warn:
        QMessageBox.warning(parent, title, message)
    else:
        QMessageBox.information(parent, title, message)


# ==========================================================================
# 1. 3D CYBERPUNK SYNTHWAVE VIDEO PREVIEW MONITOR
# ==========================================================================

class SynthwaveVideoMonitor(QWidget):
    """Real-time Direct2D hardware-rendered Cyberpunk Synthwave Video Monitor."""

    def __init__(self, parent: QWidget | None = None) -> None:
        super().__init__(parent)
        self.setMinimumSize(320, 200)
        self._phase = 0.0
        self._preset = "Cyber City Grid (Synthwave)"
        self._aspect_mode = "16:9 (FIT)"
        self._offset_ms = 0
        self._timer = QTimer(self)
        self._timer.timeout.connect(self._animate)
        self._timer.start(33)  # 30 fps

    def set_preset(self, preset_name: str) -> None:
        self._preset = preset_name
        self.update()

    def set_aspect_mode(self, mode: str) -> None:
        self._aspect_mode = mode
        self.update()

    def _animate(self) -> None:
        self._phase = (self._phase + 0.05) % 1.0
        self.update()

    def paintEvent(self, event) -> None:
        p = QPainter(self)
        p.setRenderHint(QPainter.RenderHint.Antialiasing)
        w, h = self.width(), self.height()

        # Sky background
        sky_grad = QLinearGradient(0, 0, 0, h * 0.6)
        sky_grad.setColorAt(0.0, QColor("#090214"))
        sky_grad.setColorAt(0.6, QColor("#1f0836"))
        sky_grad.setColorAt(1.0, QColor("#ff007f"))
        p.fillRect(0, 0, w, int(h * 0.6), sky_grad)

        # Ground / Grid background
        ground_grad = QLinearGradient(0, h * 0.6, 0, h)
        ground_grad.setColorAt(0.0, QColor("#030712"))
        ground_grad.setColorAt(1.0, QColor("#07021a"))
        p.fillRect(0, int(h * 0.6), w, int(h * 0.4), ground_grad)

        horizon_y = h * 0.58

        # Glowing Synthwave Sun
        sun_radius = min(w, h) * 0.22
        sun_cx = w * 0.5
        sun_cy = horizon_y - sun_radius * 0.35

        sun_grad = QLinearGradient(sun_cx, sun_cy - sun_radius, sun_cx, sun_cy + sun_radius)
        sun_grad.setColorAt(0.0, QColor("#fef08a"))
        sun_grad.setColorAt(0.5, QColor("#f43f5e"))
        sun_grad.setColorAt(1.0, QColor("#a855f7"))
        p.setBrush(QBrush(sun_grad))
        p.setPen(Qt.PenStyle.NoPen)
        p.drawEllipse(QPointF(sun_cx, sun_cy), sun_radius, sun_radius)

        # Sun horizontal stripes
        p.setPen(QPen(QColor("#090214"), 2.5))
        for s in range(5):
            sy = sun_cy + sun_radius * (0.2 + s * 0.16)
            if sy < horizon_y:
                p.drawLine(int(sun_cx - sun_radius * 0.95), int(sy), int(sun_cx + sun_radius * 0.95), int(sy))

        # Distant Cyberpunk Skyline
        p.setBrush(QBrush(QColor("#0a0418")))
        p.setPen(Qt.PenStyle.NoPen)
        num_bldgs = 18
        bw = w / num_bldgs
        for b in range(num_bldgs):
            bh = 15 + ((b * 37) % 35)
            bx = b * bw
            p.drawRect(QRectF(bx, horizon_y - bh, bw - 2, bh))

        # Perspective Grid Lines (Receding to Sun center)
        grid_pen = QPen(QColor("#00f0ff"), 1.2)
        p.setPen(grid_pen)
        vanish_x, vanish_y = w * 0.5, horizon_y
        for x_step in range(-12, 13):
            dest_x = w * 0.5 + x_step * (w * 0.08)
            p.drawLine(int(vanish_x), int(vanish_y), int(dest_x * 1.8 - w * 0.4), int(h))

        # Horizontal Grid Lines (Moving towards camera)
        for i in range(1, 9):
            pos = (i / 9.0 + self._phase * 0.12) % 1.0
            cur_y = horizon_y + (pos ** 2.2) * (h - horizon_y)
            alpha = int(255 * (pos ** 0.8))
            p.setPen(QPen(QColor(255, 0, 128, alpha), 1.2))
            p.drawLine(0, int(cur_y), w, int(cur_y))

        # Overlay Timecode HUD
        p.setFont(QFont("Consolas", 8, QFont.Weight.Bold))
        p.setPen(QPen(QColor("#22d3ee")))
        p.drawText(10, h - 10, f"TC: 00:01:00:00 • {self._aspect_mode} • 60 FPS • {self._preset}")


