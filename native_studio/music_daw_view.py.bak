    def _set_vault_density(self, size_key: str) -> None:
        font_map = {"S": "7pt", "M": "7.5pt", "L": "8.5pt"}
        pad_map = {"S": "2px 4px", "M": "4px 6px", "L": "6px 8px"}
        fs = font_map.get(size_key, "7.5pt")
        pd = pad_map.get(size_key, "4px 6px")
        self.file_list.setStyleSheet(
            f"QListWidget {{ background: #060910; border: 1px solid #162032; border-radius: 4px; color: #94a3b8; font-size: {fs}; }}"
            f"QListWidget::item {{ padding: {pd}; }}"
            f"QListWidget::item:hover {{ color: #38bdf8; }}"
        )

    def _open_cymatics_portal(self) -> None:
        self.cat_list.setCurrentRow(1)
        self._filter_vault_items("Cymatics")

    def _on_category_changed(self, row: int) -> None:
        if row == 0:
            self._filter_vault_items("")
        elif row == 1:
            self._filter_vault_items("Cymatics")
        elif row == 2:
            self._filter_vault_items("SFZ")
        elif row == 3:
            self._filter_vault_items("stems")

    def _filter_vault_items(self, query: str) -> None:
        q = query.strip().lower()
        self.file_list.clear()
        for folder in self._all_folders:
            if not q or q in folder.lower():
                self.file_list.addItem(folder)

    def _trigger_quick_beat(self, genre: str) -> None:
        if self.on_quick_beat:
            self.on_quick_beat(genre)

    def _import_audio_files(self) -> None:
        if _is_offscreen_audit():
            return
        files, _ = QFileDialog.getOpenFileNames(
            self,
            "Import Audio Files",
            "",
            "Audio Files (*.wav *.mp3 *.flac *.ogg)",
        )
        for fpath in files:
            self.file_list.addItem(f"🎵 {os.path.basename(fpath)}")

    def _compose_suno(self) -> None:
        if self.on_suno_compose:
            self.on_suno_compose()
        else:
            _safe_info_dialog(
                self,
                "Suno Prompt Schema",
                "[Verse 1 - 85 BPM Synthwave]\nNeon reflections in the October rain\nDirect Direct2D scene graph without the pain\n\n[Chorus]\nZero browser latency, hardware is free\nContiguous VRAM for eternity",
            )

    def _split_stems(self) -> None:
        if self.on_stem_split:
            self.on_stem_split()
        else:
            _safe_info_dialog(
                self,
                "Demucs 4-Stem Separation",
                "Demucs HTDEMUCS CUDA Engine ready.\nSeparating active audio into:\n"
                "Vocals (stems/vocals.wav)\n"
                "Drums (stems/drums.wav)\n"
                "Bass (stems/bass.wav)\n"
                "Other (stems/other.wav)",
            )


# ==========================================================================
# 3. CHANNEL RACK STEP SEQUENCER
# ==========================================================================

class ChannelRackGrid(QWidget):
    """Channel Rack Step Sequencer with 8 tracks and glowing interactive pads."""

    def __init__(self, engine: AudioEngine, parent: QWidget | None = None) -> None:
        super().__init__(parent)
        self.engine = engine
        self.playhead = 0
        self.setMinimumHeight(240)
        self._pad_colors = [
            QColor("#ef4444"),  # Kick (Red)
            QColor("#22c55e"),  # Snare (Green)
            QColor("#06b6d4"),  # Hi-Hat Cl (Cyan)
            QColor("#0ea5e9"),  # Hi-Hat O (Blue)
            QColor("#a855f7"),  # Clap (Purple)
            QColor("#eab308"),  # 808 Sub (Yellow)
            QColor("#ec4899"),  # Cyber Lead (Pink)
            QColor("#f97316"),  # Neon Pluck (Orange)
        ]
        self._preset_steps = [
            [0, 8],             # Kick on 1, 9
            [4, 12],            # Snare on 5, 13
            list(range(16)),    # Hi-Hat closed on all 16
            [2, 6, 10, 14],     # Hi-Hat open
            [4, 12],            # Clap
            [0, 6, 8, 14],      # 808 Sub
            [0, 3, 7, 10],      # Cyber Lead
            [1, 5, 9, 13],      # Neon Pluck
        ]
        self.pattern = np.zeros((N_TRACKS, N_STEPS), dtype=bool)
        self.apply_step_map(self._preset_steps)

    def apply_step_map(self, step_map: List[List[int]]) -> None:
        self.pattern.fill(False)
        for t in range(min(N_TRACKS, len(step_map))):
            for s in range(N_STEPS):
                active = s in step_map[t]
                self.pattern[t, s] = active
                self.engine.set_step(t, s, active)
        self.update()

    def load_genre_preset(self, genre: str) -> None:
        if genre == "trap":
            trap_steps = [
                [0, 3, 8, 11],
                [4, 12],
                list(range(16)),
                [2, 10],
                [4, 12],
                [0, 3, 7, 8, 11, 14],
                [0, 6, 12],
                [2, 8, 15],
            ]
            self.apply_step_map(trap_steps)
        else:
            self.apply_step_map(self._preset_steps)

    def randomize_pattern(self) -> None:
        rng = np.random.default_rng(int(time.time() * 1000) % (2**31))
        for t in range(N_TRACKS):
            for s in range(N_STEPS):
                val = bool(rng.random() < 0.28)
                self.pattern[t, s] = val
                self.engine.set_step(t, s, val)
        self.update()

    def mousePressEvent(self, event) -> None:
        w, h = self.width(), self.height()
        track_h = h / N_TRACKS
        pad_start_x = 160
        pad_w = (w - pad_start_x - 10) / N_STEPS

        x, y = event.position().x(), event.position().y()
        if x >= pad_start_x:
            t = int(y / track_h)
            s = int((x - pad_start_x) / pad_w)
            if 0 <= t < N_TRACKS and 0 <= s < N_STEPS:
                self.pattern[t, s] = not self.pattern[t, s]
                self.engine.set_step(t, s, bool(self.pattern[t, s]))
                self.update()

    def paintEvent(self, event) -> None:
        p = QPainter(self)
        p.setRenderHint(QPainter.RenderHint.Antialiasing)
        w, h = self.width(), self.height()
        track_h = h / N_TRACKS
        pad_start_x = 160
        pad_w = (w - pad_start_x - 10) / N_STEPS

        p.fillRect(0, 0, w, h, QColor("#090e17"))

        for t in range(N_TRACKS):
            ty = t * track_h
            p.fillRect(0, int(ty), 155, int(track_h - 2), QColor("#0e1524"))

            p.fillRect(4, int(ty + track_h * 0.25), 14, 14, QColor("#1e293b"))
            p.fillRect(20, int(ty + track_h * 0.25), 14, 14, QColor("#1e293b"))
            p.setFont(QFont("Segoe UI", 7, QFont.Weight.Bold))
            p.setPen(QColor("#64748b"))
            p.drawText(8, int(ty + track_h * 0.25 + 10), "M")
            p.drawText(24, int(ty + track_h * 0.25 + 10), "S")

            p.setPen(QColor("#f1f5f9"))
            p.setFont(QFont("Segoe UI", 8, QFont.Weight.Bold))
            p.drawText(40, int(ty + track_h * 0.6), TRACK_NAMES[t])

            col = self._pad_colors[t]
            for s in range(N_STEPS):
                px = pad_start_x + s * pad_w
                py = ty + 2
                pw = pad_w - 3
                ph = track_h - 4

                active = bool(self.pattern[t, s])
                is_cur = (s == self.playhead)

                if active:
                    p.fillRect(QRectF(px, py, pw, ph), col)
                    if is_cur:
                        p.setPen(QPen(QColor("#ffffff"), 2.0))
                        p.drawRect(QRectF(px, py, pw, ph))
                else:
                    bg_col = QColor("#141b2d") if (s // 4) % 2 == 0 else QColor("#0d1322")
                    p.fillRect(QRectF(px, py, pw, ph), bg_col)
                    if is_cur:
                        p.fillRect(QRectF(px, py, pw, ph), QColor("#00f0ff").darker(150))


# ==========================================================================
# 4. PLAYLIST ARRANGER (F5 MULTI-TRACK TIMELINE)
# ==========================================================================

class PlaylistTimeline(QWidget):
    """Playlist Arranger with clips for Video, B-Roll, Drums, Bass, Synths, and FX."""

    def __init__(self, parent: QWidget | None = None) -> None:
        super().__init__(parent)
        self.setMinimumHeight(240)
        self.playhead_x = 0.0
        self.active_tool = "Draw (P)"
        self.tracks = [
            ("🎬 V1: Main Video", [("Cyber City Drone.mp4", 1, 8, "#0284c7"), ("Matrix Tunnel.mp4", 9, 16, "#0284c7")]),
            ("🎥 V2: B-Roll & Overlays", [("Glitch Overlay.mp4", 7, 10, "#db2777")]),
            ("🥁 Drums A1", [("Drums", 1, 4, "#991b1b"), ("Drums", 5, 8, "#991b1b")]),
            ("🎸 Bassline A2", [("Bassline", 1, 4, "#065f46"), ("Bassline", 5, 8, "#065f46")]),
            ("🎹 Synth Chords A3", [("Synth Chords", 1, 4, "#0891b2"), ("Synth Chords", 5, 8, "#0891b2")]),
            ("⚡ Lead Melod... A4", [("Lead Melodies", 5, 8, "#7c3aed")]),
            ("💥 Percussion FX A5", [("Percussio...", 4, 6, "#c026d3")]),
            ("📈 Automations A6", [("AUTO: Master Dynamic Energy & Filter Sweep", 1, 16, "#4f46e5")]),
        ]

    def set_tool(self, tool_name: str) -> None:
        self.active_tool = tool_name
        self.update()

    def paintEvent(self, event) -> None:
        p = QPainter(self)
        p.setRenderHint(QPainter.RenderHint.Antialiasing)
        w, h = self.width(), self.height()
        bar_w = (w - 140) / 20.0
        track_h = (h - 22) / len(self.tracks)

        p.fillRect(0, 0, w, 22, QColor("#0b101c"))
        p.setPen(QColor("#64748b"))
        p.setFont(QFont("Segoe UI", 7, QFont.Weight.Bold))
        for b in range(1, 21):
            bx = 140 + (b - 1) * bar_w
            p.drawText(int(bx + 4), 15, str(b))
            p.drawLine(int(bx), 22, int(bx), h)

        for i, (name, clips) in enumerate(self.tracks):
            ty = 22 + i * track_h
            p.fillRect(0, int(ty), 138, int(track_h - 1), QColor("#0f172a"))
            p.setPen(QColor("#cbd5e1"))
            p.setFont(QFont("Segoe UI", 7, QFont.Weight.Bold))
            p.drawText(6, int(ty + track_h * 0.65), name)

            p.fillRect(140, int(ty), int(w - 140), int(track_h - 1), QColor("#080c16"))

            for clip_name, start_b, end_b, col_hex in clips:
                cx = 140 + (start_b - 1) * bar_w
                cw = (end_b - start_b + 1) * bar_w - 2
                p.fillRect(QRectF(cx, ty + 2, cw, track_h - 4), QColor(col_hex))
                p.setPen(QColor("#ffffff"))
                p.setFont(QFont("Segoe UI", 7, QFont.Weight.Bold))
                p.drawText(QRectF(cx + 4, ty + 2, cw - 6, track_h - 4), Qt.AlignmentFlag.AlignVCenter, clip_name)

        p.setPen(QPen(QColor("#00f0ff"), 1.8))
        px = 140 + self.playhead_x * bar_w
        p.drawLine(int(px), 0, int(px), h)


# ==========================================================================
# 5. MIXER & MASTER EFFECTS RACK (BOTTOM RIGHT)
# ==========================================================================

class MixerAndFxRack(QFrame):
    """Mixer with 5 Bus Faders, Peak VU Meters, and Master VST3 Effects Inserts."""

    def __init__(self, engine: Optional[AudioEngine] = None, parent: QWidget | None = None) -> None:
        super().__init__(parent)
        self.engine = engine
        self.meters: Dict[str, QProgressBar] = {}
        self.sliders: Dict[str, QSlider] = {}
        self.fx_states: Dict[str, bool] = {}
        self._build_ui()

    def _build_ui(self) -> None:
        self.setStyleSheet("background: #090e17; border-left: 1px solid #162032;")
        layout = QVBoxLayout(self)
        layout.setContentsMargins(8, 8, 8, 8)
        layout.setSpacing(6)

        hdr = QHBoxLayout()
        hdr.addWidget(QLabel("<b style='color: #22d3ee; font-size: 8pt;'>🎚 MIXER & MASTER EFFECTS</b>"))
        hdr.addStretch()
        self.lbl_lat = QLabel("<span style='color: #10b981; font-size: 7.5pt;'>LATENCY: &lt;2.8ms | DRIFT: ±0.0ms</span>")
        hdr.addWidget(self.lbl_lat)
        layout.addLayout(hdr)

        main_h = QHBoxLayout()
        main_h.setSpacing(8)

        faders_lay = QHBoxLayout()
        faders_lay.setSpacing(4)
        buses = [("MASTER", "#22d3ee"), ("BUS A", "#f43f5e"), ("BUS B", "#10b981"), ("BUS C", "#a855f7"), ("BUS D", "#eab308")]
        for idx, (b_name, col_hex) in enumerate(buses):
            b_box = QVBoxLayout()
            b_box.setSpacing(2)
            lbl = QLabel(b_name)
            lbl.setAlignment(Qt.AlignmentFlag.AlignHCenter)
            lbl.setStyleSheet(f"color: {col_hex}; font-size: 7pt; font-weight: bold;")
            b_box.addWidget(lbl)

            meter = QProgressBar()
            meter.setOrientation(Qt.Orientation.Vertical)
            meter.setValue(72 if b_name == "MASTER" else 60)
            meter.setTextVisible(False)
            meter.setFixedWidth(12)
            meter.setStyleSheet(
                f"QProgressBar {{ background: #060910; border: 1px solid #1e293b; border-radius: 2px; }}"
                f"QProgressBar::chunk {{ background: qlineargradient(x1:0, y1:1, x2:0, y2:0, stop:0 {col_hex}, stop:0.8 #22c55e, stop:1 #ef4444); }}"
            )
            b_box.addWidget(meter, 1, Qt.AlignmentFlag.AlignHCenter)
            self.meters[b_name] = meter

            slider = QSlider(Qt.Orientation.Vertical)
            slider.setRange(0, 100)
            slider.setValue(80)
            slider.setFixedHeight(60)
            slider.valueChanged.connect(lambda val, bus=b_name, b_idx=idx: self._on_fader_changed(bus, b_idx, val))
            b_box.addWidget(slider, 0, Qt.AlignmentFlag.AlignHCenter)
            self.sliders[b_name] = slider

            faders_lay.addLayout(b_box)

        main_h.addLayout(faders_lay)

        fx_card = QFrame()
        fx_card.setStyleSheet("background: #060910; border: 1px solid #1e293b; border-radius: 4px; padding: 6px;")
        fx_lay = QVBoxLayout(fx_card)
        fx_lay.setContentsMargins(4, 4, 4, 4)
        fx_lay.setSpacing(4)

        fx_lay.addWidget(QLabel("<b style='color: #38bdf8; font-size: 7.5pt;'>⚡ EFFECT INSERTS</b>"))

        effects = [
            ("Tone.Reverb", "Decay: 2.5s • Wet: 30%", True),
            ("Feedback Delay", "Time: 8n Sync • Wet: 25%", True),
            ("Overdrive Saturation", "Drive: 0.3", True),
            ("Vocal Pitch Snap", "Amount: 0 Semitones", False),
        ]
        for name, sub, checked in effects:
            self.fx_states[name] = checked
            chk = QCheckBox(f"{name} ({sub})")
            chk.setChecked(checked)
            chk.setStyleSheet("color: #cbd5e1; font-size: 7pt;")
            chk.toggled.connect(lambda state, fx_name=name: self._on_fx_toggled(fx_name, state))
            fx_lay.addWidget(chk)

        vst_box = QHBoxLayout()
        vst_box.addWidget(QLabel("<span style='color: #eab308; font-size: 7pt;'>Native VST3 Host:</span>"))
        self.btn_port = QPushButton("PORT 8013")
        self.btn_port.setStyleSheet("background: #ca8a04; color: #000; font-size: 7pt; font-weight: bold; border-radius: 2px; padding: 2px 4px;")
        self.btn_port.clicked.connect(self._probe_vst3_port)
        vst_box.addWidget(self.btn_port)
        fx_lay.addLayout(vst_box)

        main_h.addWidget(fx_card, 1)
        layout.addLayout(main_h, 1)

    def _on_fader_changed(self, bus_name: str, bus_idx: int, value: int) -> None:
        if bus_name in self.meters:
            self.meters[bus_name].setValue(min(100, int(value * 0.9)))
        if self.engine is not None and hasattr(self.engine, "set_gain") and bus_idx < N_TRACKS:
            try:
                self.engine.set_gain(bus_idx, value / 100.0)
            except Exception:
                pass

    def _on_fx_toggled(self, fx_name: str, state: bool) -> None:
        self.fx_states[fx_name] = state

    def _probe_vst3_port(self) -> None:
        sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        sock.settimeout(0.5)
        try:
            is_up = sock.connect_ex(("127.0.0.1", 8013)) == 0
        except Exception:
            is_up = False
        finally:
            sock.close()
        status_txt = "ONLINE" if is_up else "STANDBY"
        self.btn_port.setText(f"PORT 8013 ({status_txt})")


