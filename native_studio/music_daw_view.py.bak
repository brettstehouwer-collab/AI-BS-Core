class MusicDawView(QWidget):
    """AI Music Studio (DAW) Native PyQt6 View."""

    def __init__(self, bus: EngineBus | None = None, engine: AudioEngine | None = None) -> None:
        super().__init__()
        if isinstance(bus, AudioEngine):
            self.engine = bus
            self.bus = engine or EngineBus(max_threads=4)
        else:
            self.bus = bus or EngineBus(max_threads=4)
            self.engine = engine if engine is not None else AudioEngine()
        self._active_view = "multimedia"
        self._recording = False
        self._metronome_click = False
        self._transport_mode = "PAT"
        self._build_ui()

        self._timer = QTimer(self)
